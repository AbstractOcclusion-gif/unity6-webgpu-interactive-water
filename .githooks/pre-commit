#!/bin/sh

if command -v pwsh >/dev/null 2>&1
then
    exec pwsh -NoProfile -File .githooks/check-line-endings.ps1
fi

if command -v powershell.exe >/dev/null 2>&1
then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File .githooks/check-line-endings.ps1
fi

printf '%s\n' "Line-ending check failed: PowerShell is required but was not found."
exit 1

