// WebGpuWater - GPU foam particles (KWS-inspired)
//
// Particles spawn on the GPU where the sim's foam/turbulence is strong, drift with
// the surface flow, and are drawn by FoamParticles.shader straight from the buffer
// (no CPU round trip). WebGPU-safe by construction:
//   - no Append/Consume buffers: a ring cursor advanced with InterlockedAdd claims
//     DEAD slots only (bounded probe; a saturated pool drops the spawn, never a
//     living particle - see ClaimPoolSlot),
//   - the sim state is read with Load + manual bilinear (r32/float RTs are not
//     filterable on WebGPU),
//   - fixed-capacity pool; dead slots are skipped by the vertex shader.
//
// Four particle kinds share one pool:
//   KIND_SURFACE: floats on the water, dragged by the local flow + wind.
//   KIND_SPRAY:   ballistic droplets thrown off strong turbulence; on landing they
//                 convert to KIND_SURFACE and keep drifting as foam.
//   KIND_BUBBLE:  underwater plume injected DOWNWARD by splash bursts; buoyancy turns it
//                 around and it pops into KIND_SURFACE at the waterline (or dissolves).
//   KIND_RIPPLE_CREST: small surface flecks emitted from energetic ripple crests.

#pragma kernel BeginFrame
#pragma kernel Spawn
#pragma kernel SpawnBurst
#pragma kernel Update
#pragma kernel ClearDensity
#pragma kernel RasterizeDensity

// Ocean-only: FFT placement glue - SurfaceWorldY sums the spatial cascades so floating foam and the
// density splat sit on the real swell. The variant also gates AMBIENT spawning off (open-sea sprite
// foam reads as flat billboards; the surface shader's whitecaps own that look - only the surf lip
// throws). Off for pools/bounded bodies, so the cascade texture is never declared or bound there.
#pragma multi_compile _ OCEAN_FFT_GLUE

#include "WaterShared.hlsl"     // OCEAN_FFT_* cascade layout (shared with generation/sampling)
#ifdef OCEAN_FFT_GLUE
#include "WaterSeaStateFetch.hlsl" // only the ocean height-glue variant owns this resource
#include "WaterOceanAperiodic.hlsl"
#endif
#include "WaterExclusion.hlsl"  // dry-interior volumes: particles inside are killed (uniforms set per dispatch)
#include "WaterVolume.hlsl"     // pool/window <-> world frame (same uniforms as the render side)
#include "WaterWaves.hlsl"      // per-body wind-wave height (uniforms explicitly bound from C#)
#include "WaterFoamCommon.hlsl" // FoamParticleEnvelope: shared with the quad render
#include "WaterSurfWaves.hlsl"  // surf breaker fronts: plunging-lip spray source (uniforms set by
                                // WaterSimulation.ShoreFoamState.BindTo - compute sees no globals)
// Shared particle plumbing: PCG hash + the Layer A shore-field fetch (uniforms, textures
// and the ONE fail-fast sampler both particle computes use).
#define WATER_PARTICLE_SHORE_FIELD 1
#include "WaterParticleCommon.hlsl"

// MUST equal WaterFoamParticles.SpawnThreadGroupSize / UpdateThreadGroupSize (C#) -
// WaterWaveConstantsValidator guards both pairs.
#define SPAWN_THREAD_GROUP_SIZE  8
#define UPDATE_THREAD_GROUP_SIZE 64

static const float KIND_SURFACE = 0.0;
static const float KIND_SPRAY   = 1.0;
static const float KIND_BUBBLE  = 2.0; // MUST match KIND_BUBBLE in FoamParticles.shader
static const float KIND_RIPPLE_CREST = 3.0;

// ---- KIND_BUBBLE tuning (physics-anchored; see docs/PLAN_bubbles_v1.md) ----
// Injection: the plume enters just under the surface moving DOWN at a fraction of the
// burst's up-throw; buoyancy then turns it around, so plume depth EMERGES from the two.
static const float BUBBLE_SPAWN_DEPTH = 0.06;      // metres below the surface at birth
static const float BUBBLE_PLUNGE_FACTOR = 0.9;     // down-speed = burst upSpeed * this
static const float BUBBLE_LATERAL_FACTOR = 0.25;   // sideways speed = burst outSpeed * this
static const float BUBBLE_SIZE_SKEW = 2.0;         // pow() on the size roll: mostly small
// Rise: exponential relax toward a size-scaled terminal speed (measured band 0.2-0.3 m/s
// for mm-class bubbles; smaller bubbles are slower).
static const float BUBBLE_BUOYANCY_RESPONSE = 2.0;     // 1/sec relax toward terminal rise
static const float BUBBLE_RISE_SIZE_MIN_FACTOR = 0.55; // smallest bubbles rise at this fraction
// Wobble: only mm+ bubbles zigzag (path instability), so amplitude is size-gated; the noise
// track drifts with age PER PARTICLE so neighbours never wobble in lockstep.
static const float BUBBLE_WOBBLE_SCALE = 9.0;      // noise features per world metre
static const float BUBBLE_WOBBLE_RATE = 1.5;       // track drift per second of age
static const float BUBBLE_WOBBLE_SPEED = 0.06;     // world units/sec at full size, wobble 1


// Counters buffer layout. MUST match WaterFoamParticles.CounterCount (C#).
static const uint COUNTER_RING_CURSOR = 0; // ever-increasing spawn cursor (ring index)
static const uint COUNTER_FRAME_SPAWNS = 1; // turbulence spawns this frame (budget check)
static const uint COUNTER_BURST_SPAWNS = 2; // burst droplets this frame (own budget below)
static const uint COUNTER_CREST_FLECK_SPAWNS = 3; // ripple-crest flecks this frame (own budget)

// Burst droplets get their OWN per-frame budget = capacity / this (they are event-driven
// and must not starve behind the turbulence budget, but 16 requests x 64 droplets could
// previously recycle a quarter of a small pool in one frame, killing living foam).
static const uint BURST_FRAME_CAP_DIVISOR = 4;

// Spray landing: below this height offset the droplet becomes surface foam.
static const float SPRAY_LANDING_EPSILON = 0.005;
// Landing keeps a fraction of the horizontal speed (energy lost to the impact).
static const float SPRAY_LANDING_KEEP = 0.4;
// Kill particles this far outside the active sim frame (pool or window), in
// normalised units; a little slack so foam can hug the walls before dying.
static const float FRAME_KILL_MARGIN = 0.02;
// Window-edge fade band (normalised frame units, measured inward from the edge): inside
// it a particle AGES faster (up to FRAME_FADE_AGE_BOOST x at the very edge), so its life
// envelope fades it out before the hard kill above ever fires. Without this, the kill
// line of the camera-following window sweeps through world-anchored foam and reads as
// "the foam cloud is glued to the camera" (same defect class the roller's world snap
// fixed). The hard kill stays as the backstop where the frame has no sim data.
static const float FRAME_FADE_BAND = 0.15;
static const float FRAME_FADE_AGE_BOOST = 3.0;

// Exclusion-volume fade (same idiom as the window-edge band): a dry volume sweeping INTO
// live sprites - a moving boat hull plowing through its own bow spray - must not hard-pop
// them out in one frame. Inside a volume the particle ages faster instead, ramping with
// the normalised interior depth (ExclusionParticleInteriorDepth): a face graze dissolves over a
// few tenths of a second, the deep interior still vanishes near-instantly so nothing
// lingers floating in a dry room.
static const float EXCLUSION_FADE_SHELL = 0.2;      // unit-box depth over which the boost ramps
static const float EXCLUSION_FADE_AGE_BOOST_MIN = 4.0;   // at a face graze
static const float EXCLUSION_FADE_AGE_BOOST_MAX = 30.0;  // deep inside

// Slot claim (ClaimPoolSlot): ring-cursor probes per spawn before giving up. The old raw
// "cursor & mask" claim OVERWROTE whatever lived at the cursor, so under spawn pressure
// (a moving boat's wake saturating the budget) the ring wrapped in a handful of frames and
// stomped mid-life particles pool-wide - the whole foam field strobed. Probing for DEAD
// slots and DROPPING the spawn when none is found turns overload into graceful saturation:
// new foam is lost for a frame, living foam is never killed.
static const uint SLOT_CLAIM_PROBES = 8u;

// World-anchored spawn identity: spawn decisions are keyed on a fixed WORLD lattice
// instead of window texel ids, so what emits belongs to the water surface, not to
// wherever the camera-following sim window happens to sit this frame. Cell edge = one
// sim texel, floored so ultra-fine sims don't alias into sub-lattice noise.
static const float SPAWN_CELL_MIN_METERS = 0.25;
// KWS keep-alive floor (FOAM_MIN_LOD_COUNT idiom): a sparse dusting of cells emits even
// beyond the distance-LOD range, so foam already exists when the camera turns or
// approaches instead of visibly popping in around it.
static const float SPAWN_LOD_KEEP_ALIVE = 0.02;
// Distance-LOD falloff shape (KWS pow5-shoulder idiom): FULL density out to this fraction
// of the range, then a smooth shoulder down to the keep-alive floor. The old linear
// ticket-vs-distance curve started thinning right at the camera (~half the cells rejected
// only 25% into the range), so the foam field read as a soft blob whose density gradient
// travelled with the camera - especially as the connected screen-space density veil,
// where the gradient is one visible shape instead of scattered sprites.
static const float SPAWN_LOD_PLATEAU = 0.6;

// One particle = 52 bytes. MUST match FoamParticle in FoamParticles.shader and
// the stride in WaterFoamParticles.cs.
struct FoamParticle
{
    float3 worldPos; // world xz; y = height offset ABOVE the local water surface
    float3 velocity; // world units/sec (y used while KIND_SPRAY)
    float  age;      // seconds since spawn
    float  life;     // seconds; <= 0 marks a dead slot
    float  size;     // world half-size of the quad
    float  seed;     // 0..1, fixed per particle (sprite variant, yaw, jitter)
    float  kind;     // KIND_SURFACE or KIND_SPRAY
    float  strength; // foam amount at spawn, scales opacity
    float  opacity;  // per-particle visual opacity; impact bursts can differ from ambient spray
};

RWStructuredBuffer<FoamParticle> Particles;
// Crest flecks alone need motion history for their KWS-style trail rendering. Kept separate from
// FoamParticle so generic foam, spray and bubbles retain their established buffer layout.
RWStructuredBuffer<float3> CrestFleckPreviousPositions;
RWStructuredBuffer<uint> Counters;

// Sim inputs (same textures the Foam kernel reads).
Texture2D<float4> Sim;      // (height, velocity, normal.x, normal.z)
Texture2D<float2> SimHorizontalFlow; // local horizontal ripple velocity, metres per second
Texture2D<float>  FoamTex;  // foam amount (R)

float _Size;              // sim grid resolution
// _SimEdgeFadeTexels is declared by WaterVolume.hlsl (included above) - it was already in scope
// here, just never SET on this compute, so it read 0 and the particles skipped the band the
// surface fades over. The C# side now binds it; see SimWindowRippleFade.
uint  _Capacity;          // particle pool size (power of two)
uint  _FrameSeed;         // per-frame random salt
float _DeltaTime;

// Spawn tuning
float _SpawnThreshold;    // foam level below which nothing spawns
float _SpawnRate;         // expected spawns / second / world-unit^2 at foam = 1
uint  _MaxSpawnPerFrame;  // hard budget per frame
float _SprayChance;       // 0..1 fraction of spawns thrown as ballistic spray
float _SprayLaunchSpeed;  // world units/sec initial upward speed of spray
float _RippleCrestFlecksEnabled;
float _RippleCrestFleckAmount;
uint _RippleCrestFleckMaxPerFrame;
float _RippleCrestFleckLifeMin, _RippleCrestFleckLifeMax;
float _RippleCrestFleckSizeMin, _RippleCrestFleckSizeMax;
float _RippleCrestFleckMotion;
float _LifeMin, _LifeMax; // seconds
float _SizeMin, _SizeMax; // world units
float _SizeHeroPower;     // >= 1; KWS pow-distribution: most particles small, rare heroes
// Spray droplets get their OWN size + lifetime so they tune apart from floating foam.
float _SprayLifeMin, _SprayLifeMax; // seconds (KIND_SPRAY only)
float _SpraySizeMin, _SpraySizeMax; // world units (KIND_SPRAY only)
// Deposited foam: what a LANDED droplet (mist or splash burst) turns into. Re-rolled on
// landing so the surface patch tunes apart from the airborne droplet that made it.
float _DepositLifeMin, _DepositLifeMax; // seconds
float _DepositSizeMin, _DepositSizeMax; // world units
// Bubble plume (KIND_BUBBLE): what a splash burst injects under the surface.
float _BubbleAmount;                    // bubbles per droplet thrown (0..1 share of burst.count)
float _BubbleRiseSpeed;                 // terminal rise of the LARGEST bubbles (world units/sec)
float _BubbleLifeMin, _BubbleLifeMax;   // seconds (dissolve timer; surfacing pops first)
float _BubbleSizeMin, _BubbleSizeMax;   // world units, skewed small on spawn
float _BubbleWobble;                    // sideways wobble amplitude scale (size-gated in Update)
float _TexelWorldArea;    // world-space area covered by one sim texel

// Update tuning
float _Gravity;           // world units/sec^2 (positive down)
float _FlowDrift;         // world units/sec of drift per unit of surface slope
float2 _WindDrift;        // constant world-space xz drift from the wind
float _Drag;              // 1/sec velocity relaxation toward the driven speed

// ---- Screen-space density foam (KWS: particles accumulate into a density buffer instead of
// drawing overlapping quads; a fullscreen composite turns density into connected, lit foam). ----
RWStructuredBuffer<uint> DensityBuffer; // per density texel: fixed-point accumulated foam weight
RWStructuredBuffer<uint> DensityDepth;  // per density texel: min eye depth (millimetres) for occlusion
// KWS LOD tiers: a fleck's DOT SIZE is the resolution of the buffer it lands in. Tier 0 is the
// base buffer above; tiers 1/2 halve the resolution per step, so one splat covers 2x/4x the
// screen. Only ripple-crest flecks use the tiers (projected size + per-particle random
// threshold jitter, KWS's +-35%); floating foam keeps its tier-0 disc veil. Depth stays
// base-resolution: one occlusion field serves all tiers (the tier splat floods its footprint).
RWStructuredBuffer<uint> DensityBufferTier1;
RWStructuredBuffer<uint> DensityBufferTier2;
RWStructuredBuffer<uint> TileCounts;    // per screen tile: spray spawns this frame (budget)

uint2    _DensitySize;       // density buffer dimensions (a fraction of the camera target)
float4x4 _DensityViewProj;   // camera GPU view-projection (same matrix family the render uses)
float    _DensityProj11;     // projection [1][1]: vertical focal term for projected-size estimates
float    _DensityWeightScale;// fixed-point units per 1.0 of foam weight
float    _DensitySurfaceSizeScale;
Texture2D<float4> _DensityStampTex;
float2 _DensityStampGrid;

// Spawn quality (KWS trio)
float2 _SpawnCameraXZ;       // camera ground position for the stochastic distance LOD
float  _SpawnMaxDistance;    // metres; beyond this no particles spawn. 0 = LOD disabled
float  _TileBudgetEnabled;   // 1 when a camera is available to project spray spawns
uint   _SprayTileCap;        // max spray spawns per screen tile per frame

// Wave occlusion for the density splat is NOT done here: the composite writes the
// splatted min depth to SV_Depth and z-tests LEqual against the live depth buffer,
// which already contains every wave crest (the water surface is ZWrite On and draws
// before the veil). Exact, per pixel, and free per particle - an analytic camera-ray
// march against the composed surface height was tried and rejected (4x SurfaceWorldY
// per particle per frame, and crests between samples slipped through).

// Depth quantisation for the InterlockedMin buffer: millimetres in uint.
// DEPTH_TO_MM comes from WaterFoamCommon.hlsl (its inverse lives beside it - one pair).
// Density buffer cleared depth (no particle) - uint max.
static const uint DEPTH_CLEAR = 0xFFFFFFFFu;
// Atlas footprint clamp in half-resolution density texels. Landing foam is sparse now that the
// autonomous source is experimental/off, so it can afford a larger bounded footprint. The old
// radius-three cap collapsed the profile's 0.2-0.5 m size range to the same six-screen-pixel dot.
static const int SURFACE_ATLAS_RADIUS_MIN = 1;
static const int SURFACE_ATLAS_RADIUS_MAX = 16;
// LOD tier selection (crest flecks): projected DIAMETER thresholds in tier-0 texels, each
// wobbled +-JITTER_FRACTION per particle so same-distance flecks spread across neighbouring
// tiers and the dots read in three sizes (KWS: particleScreenSize + rand * lod * 0.35 <= lod).
static const float DENSITY_TIER0_MAX_DIAMETER_TEXELS = 1.5;
static const float DENSITY_TIER1_MAX_DIAMETER_TEXELS = 3.0;
static const float DENSITY_TIER_JITTER_FRACTION = 0.35;
// A point-only deposit leaves the clumping simulation visible as isolated square flecks. A
// compact tent footprint lets neighbouring flecks accumulate into the density veil while the
// selected tier remains authoritative for their apparent size.
static const int DENSITY_FLECK_FOOTPRINT_RADIUS = 1;
static const float DENSITY_FLECK_FOOTPRINT_AXIS_FALLOFF = 0.5;

// Integer halving per tier - the composite derives its sizes with the SAME formula, so the
// index math of the pair can never disagree.
uint2 DensityTierSize(uint tier)
{
    return max(uint2(1u, 1u), uint2(_DensitySize.x >> tier, _DensitySize.y >> tier));
}

void AddFleckDensity(uint tier, uint index, uint weight)
{
    if (tier == 0u) InterlockedAdd(DensityBuffer[index], weight);
    else if (tier == 1u) InterlockedAdd(DensityBufferTier1[index], weight);
    else InterlockedAdd(DensityBufferTier2[index], weight);
}

void WriteFleckDepth(uint2 tierPixel, uint tier, uint depthMm)
{
    uint side = 1u << tier;
    uint2 baseOrigin = tierPixel * side;
    for (uint y = 0u; y < side; y++)
        for (uint x = 0u; x < side; x++)
        {
            uint2 basePixel = min(baseOrigin + uint2(x, y), _DensitySize - uint2(1u, 1u));
            InterlockedMin(DensityDepth[basePixel.y * _DensitySize.x + basePixel.x], depthMm);
        }
}
// Screen tile grid for the spray budget (KWS buckets splash into 64px tiles; a fixed 16x16
// grid is resolution-independent and keeps the counter buffer tiny).
static const uint TILE_GRID = 16;
// Spawn-probability boost per unit of local velocity shear (wake edges emit more).
static const float SPAWN_SHEAR_BOOST = 4.0;

// KWS emits small foam flecks from dynamic-wave height, horizontal flow and divergence. This solver
// stores height and vertical velocity instead, so positive moving height selects the source while
// the height-gradient direction supplies its travel below.
static const float CREST_FLECK_MIN_HEIGHT_METERS = 0.001;
static const float CREST_FLECK_HEIGHT_RANGE_METERS = 0.02;
// Peakness is curvature normalised by the local ripple amplitude. This keeps a smooth low ripple
// eligible while restricting flecks to its narrow positive apex rather than its whole upper half.
static const float CREST_FLECK_PEAKNESS_MIN = 0.001;
static const float CREST_FLECK_MIN_LOCAL_AMPLITUDE = 1e-6;
// KWS accepts only a minority of energetic source texels, then emits a local cluster from each
// accepted source. Keeping the source decision sparse is what reads as distinct trails instead
// of a uniform dusting along the entire crest.
static const float CREST_FLECK_SOURCE_SELECTION_CHANCE = 0.5;
static const uint CREST_FLECK_MAX_SPAWNS_PER_TEXEL = 12u;
static const float CREST_FLECK_CLUSTER_STRENGTH_MULTIPLIER = 12.0;
// The foam-mask re-emission source stays SPARSE and small-clustered: it exists to keep decayed
// wake areas alive as scattered clumps, not to become a second full-density field (the
// "dispatched everywhere" failure). Crest sources keep the dense treatment above.
static const float CREST_FLECK_FOAM_SOURCE_SELECTION_CHANCE = 0.1;
static const uint CREST_FLECK_FOAM_MAX_SPAWNS_PER_TEXEL = 2u;
// FRONT COHERENCE - the MEASURED discriminator (numpy harness of this sim, 2026-08-07:
// on the moving-emitter + splash scenario it concentrates spawn probability on the primary
// ring at ~4x the leading-ring share of relative flow divergence, which could not separate
// the ring from the dust at all - every trailing crest is a real compressive front too).
// The sim's VERTICAL velocity (info.g) is single-signed across a first-arrival wavefront -
// the whole neighbourhood rises together - while the trailing dispersive train and the
// interference chop behind a moving source alternate sign across the 13-tap cross, so
// |sum| / sum(abs) reads near 1 at the energy front and near 0 everywhere behind it. THIS
// is what separates the primary ripple from the dust field. Dimensionless, so every body
// scale gates identically. The +-6 reach spans roughly one trailing-train wavelength;
// that span is what makes the train cancel itself.
static const float CREST_FLECK_COHERENCE_LO = 0.6;
static const float CREST_FLECK_COHERENCE_HI = 0.9;
static const float CREST_FLECK_COHERENCE_ABS_EPS = 1e-9;
// Spawn-direction epsilon: keeps the cluster's normalize() finite when a leading crest
// spawns before the passive flow layer has built up under it (KWS's normalize(v + (0,
// 0.001)) idiom).
static const float CREST_FLECK_FLOW_EPSILON = 0.001;
// KWS offsets its cluster by pow(deltaTime * 15, 2): 0.0625 texels at its 60 Hz reference rate.
// The compact seed lets subsequent live-flow advection, rather than spawn smearing, form a trail.
static const float CREST_FLECK_CLUSTER_OFFSET_TEXELS = 0.0625;
static const uint CREST_FLECK_CLUSTER_SEED = 0x68BC21EBu;
static const float CREST_FLECK_MIN_FLOW_SPEED_METERS_PER_SECOND = 0.01;
static const float CREST_FLECK_MIN_FLOW_SPEED_SQUARED =
    CREST_FLECK_MIN_FLOW_SPEED_METERS_PER_SECOND * CREST_FLECK_MIN_FLOW_SPEED_METERS_PER_SECOND;
static const float CREST_FLECK_BEHIND_FLOW_TEXELS = CREST_FLECK_CLUSTER_OFFSET_TEXELS;
static const float CREST_FLECK_LATERAL_SPREAD_TEXELS = CREST_FLECK_CLUSTER_OFFSET_TEXELS;
static const float CREST_FLECK_LIFE_MULTIPLIER = 2.5;
static const float CREST_FLECK_FLOW_RESPONSE_MIN = 0.3;
static const float CREST_FLECK_FLOW_RESPONSE_MAX = 0.65;
static const float CREST_FLECK_UNDULATION_SCALE = 0.15;
static const float CREST_FLECK_UNDULATION_RATE = 1.5;
static const float CREST_FLECK_UNDULATION_SPEED = 0.08;
static const float CREST_FLECK_HISTORY_HERTZ = 15.0;
static const float CREST_FLECK_AUTHORED_DRIFT_MAX_FLOW_FRACTION = 0.25;
static const float CREST_FLECK_INACTIVE_FLOW_FADE_SECONDS = 0.75;
// Foam-mask feedback (KWS OR-acceptance): spawn accepts on the persistent sim foam mask OR the
// live crest, so an area that churned once keeps emitting flecks while its foam decays -
// sustained trails instead of one puff per crest pass. MIN/RANGE map the mask to a source
// strength; WEIGHT caps how strong a pure mask source can get vs a live crest.
static const float CREST_FLECK_FOAM_MASK_MIN = 0.3;
static const float CREST_FLECK_FOAM_MASK_RANGE = 0.5;
static const float CREST_FLECK_FOAM_MASK_WEIGHT = 0.5;
// Clump pull (KWS FoamClumping): a drag UP the shared foam noise gradient gathers flecks
// into lanes/patches instead of a uniform dusting. Same field the floating foam uses.
// KWS gates the attraction by MID-LIFE (sine envelope) x SLOWNESS, so grouping peaks exactly
// once the crest that threw the fleck has passed. FLOOR keeps a trace of pull always on
// (KWS's +0.1); SLOW_SPEED = planar speed (m/s) at which the slowness gate fully closes.
static const float CREST_FLECK_CLUMP_SPEED = 0.15;
static const float CREST_FLECK_CLUMP_FLOOR = 0.25;
static const float CREST_FLECK_CLUMP_SLOW_SPEED = 0.5;

// Surf plunging-lip spray (CURL-3, the KWS crash moment): a spawn on a cresting PLUNGING front is
// forced to ballistic spray thrown shoreward off the lip. The gate reads the front's canonical
// breaker signal (cresting-lip line, plunge-amplified, surge-killed - WaterSurfWaves.hlsl), so
// spilling shelves and surging cliffs throw nothing. The whitewash the shore injection already
// writes into the foam buffer covers spawn PROBABILITY; these only shape what spawns there.
// (Shore border feather + deep sentinel now come from WaterShoreMath.hlsl - via
// WaterParticleCommon.hlsl - as SHORE_BORDER_FEATHER / SHORE_DEEP_SENTINEL: the ONE copy
// shared with the surface shaders and the foam sim.)
// A cascade's shore attenuation uses one representative wavelength = this fraction of its
// domain size - OCEAN_FFT_CASCADE_WAVELENGTH_FRACTION from WaterShared.hlsl, the SAME define
// the sampling side (WaterLargeWaves.hlsl) uses, so the two can no longer drift.

// ---- CPU-event splash bursts (spray unification): rigidbody impacts and mouse splashes
// queue burst requests on the CPU; the SpawnBurst kernel throws KIND_SPRAY droplets from
// the same pool, so ALL airborne droplets share one tech path + one look (the Shuriken
// system keeps only the one-shot crown flipbook). MUST match BurstRequest in
// WaterFoamParticles.cs (68 bytes) and MAX_BURST_DROPLETS <= the kernel thread count. ----
struct BurstRequest
{
    float3 center;   // world surface position of the impact
    float  radius;   // world ring radius droplets spawn on
    float  strength; // 0..1 impact strength: scales opacity via particle.strength
    float  upSpeed;  // world units/sec base upward pop
    float  outSpeed; // world units/sec base outward throw
    float  seed;     // per-burst random salt
    float  count;    // droplets requested (<= MAX_BURST_DROPLETS)
    // Per-burst droplet life/size (was padding): bursts tune on the WaterSplashEmitter,
    // fully independent of the ambient-mist _SprayLife/_SpraySize.
    float  lifeMin;  // seconds
    float  lifeMax;  // seconds
    float  size;     // world half-size before jitter
    // Petal arc. A ZERO (dirX, dirZ) is the legacy full ring, so every splash authored before
    // hull fitting still spawns byte-identically.
    float  dirX;             // world X of the unit direction the wedge is centred on
    float  dirZ;             // world Z of the same
    float  arcHalfRadians;   // half-width of the wedge; ignored when the direction is zero
    // Lifts (or flattens) the whole burst in its own vertical plane. ZERO is the untouched original.
    // Independent of the arc: a full-ring burst tilts just as happily as a petal.
    float  elevationRadians;
    float  dropletOpacity;
};
StructuredBuffer<BurstRequest> BurstRequests;
uint _BurstRequestCount;

static const uint  MAX_BURST_DROPLETS = 64;   // one thread group per request
// Per-droplet jitters, matching the legacy Shuriken burst's feel. MUST match the
// counterpart consts in WaterSplashEmitter.cs (the fallback path) - guarded by
// WaterWaveConstantsValidator, so a retune on either side is reported on editor load.
static const float BURST_OUT_JITTER_MIN = 0.4;
static const float BURST_OUT_JITTER_MAX = 1.0;
static const float BURST_UP_JITTER_MIN = 0.5;
static const float BURST_UP_JITTER_MAX = 1.2;
static const float BURST_SPAWN_HEIGHT = 0.01;  // just above the surface, never submerged
static const float BURST_RING_RADIUS_SCALE = 0.5; // spawn inside half the impact radius
// Below this squared length a burst's direction is the ZERO SENTINEL: throw the legacy full ring.
// Mirrored by WaterSplashEmitter.BurstDirectionMinSquared so the GPU and Shuriken paths agree on
// which bursts are petals - guarded by WaterWaveConstantsValidator.
static const float BURST_DIR_MIN_SQ = 1e-8;
// Below this the elevation is "unset" and the velocity line runs untouched, so a burst authored
// before the tilt existed is bit-for-bit what it always was.
static const float BURST_ELEVATION_MIN = 1e-5;
// Straight up. The tilt ADDS to the elevation the emitter's up/out speeds already imply, so it is
// capped here rather than allowed to rotate past vertical and throw droplets back through the hull.
static const float BURST_MAX_ELEVATION = 1.5707963;
static const float BURST_SIZE_JITTER_MIN = 0.6;   // matches WaterSplashEmitter.SizeJitterMin
static const float BURST_SIZE_JITTER_MAX = 1.3;   // matches WaterSplashEmitter.SizeJitterMax

// ---- Foam motion richness (KWS curl + clumping): floating foam is swirled by a
// divergence-free curl field and gently attracted toward noise maxima, so it gathers
// into streaks/patches instead of staying a uniform sprinkle. ----
float _FoamTime; // slow world clock for the noise drift
static const float FOAM_NOISE_SCALE   = 0.7;   // noise features per world metre
static const float FOAM_NOISE_DRIFT   = 0.05;  // field drift speed (keeps clumps alive)
static const float FOAM_CURL_SPEED    = 0.06;  // world units/sec of swirl
static const float FOAM_CLUMP_SPEED   = 0.04;  // world units/sec of attraction

#ifdef OCEAN_FFT_GLUE
// FFT spatial cascade (.y = height) + amplitude, so the density splat can place foam on the
// real swell height the way FoamParticles.shader's vertex glue does with LargeBodyWaveHeight.
Texture2DArray<float4> _OceanFftSpatial;
SamplerState sampler_OceanFftSpatial;
float _OceanFftAmplitude;
Texture2D<float4> _OceanDirectionMap;
float4 _OceanAperiodicParams;
float4 _OceanDirectionMapFrame;
#endif

#ifdef OCEAN_FFT_GLUE
// FFT cascade layout (bound per-frame from WaterFoamParticles.cs; same values the surface uses).
// Read by SurfaceWorldY's cascade sum - swell placement is all this keyword drives now.
float4 _OceanFftDomainSizes;   // metres per cascade
float  _OceanFftCascadeCount;  // active cascades (<= 4)
// OCEAN_FFT_MAX_CASCADES comes from WaterShared.hlsl (via the include block above).
#endif

#ifdef OCEAN_FFT_GLUE
float2 OceanParticleDirectionMapBilinear(float2 uv)
{
    uint width, height;
    _OceanDirectionMap.GetDimensions(width, height);
    float2 texel = saturate(uv) * float2(max((int)width - 1, 0), max((int)height - 1, 0));
    int2 p0 = (int2)floor(texel);
    int2 p1 = min(p0 + 1, int2((int)width - 1, (int)height - 1));
    float2 fraction = frac(texel);
    float2 row0 = lerp(_OceanDirectionMap.Load(int3(p0, 0)).rg,
                       _OceanDirectionMap.Load(int3(p1.x, p0.y, 0)).rg, fraction.x);
    float2 row1 = lerp(_OceanDirectionMap.Load(int3(p0.x, p1.y, 0)).rg,
                       _OceanDirectionMap.Load(int3(p1, 0)).rg, fraction.x);
    return lerp(row0, row1, fraction.y);
}

float OceanParticleTileAngle(float2 tileWorldCenter)
{
    float2 mapUv = (tileWorldCenter - _OceanDirectionMapFrame.xy) * _OceanDirectionMapFrame.z + 0.5;
    if (any(mapUv < 0.0) || any(mapUv > 1.0)) return 0.0;
    float2 encodedDirection = OceanParticleDirectionMapBilinear(mapUv);
    return OceanAperiodicDirectionAngle(encodedDirection, _OceanAperiodicParams.z);
}

float OceanParticleTileHeight(float2 worldXZ, float domain, float slice, int2 vertex)
{
    float2 tileCenterUv = OceanAperiodicVertexUv(vertex, _OceanAperiodicParams.y);
    float2 tileWorldCenter = tileCenterUv * domain;
    float angle = OceanParticleTileAngle(tileWorldCenter);
    float2 localWorld = OceanAperiodicRotate(worldXZ - tileWorldCenter, -angle);
    float2 uv = localWorld / domain + tileCenterUv + OceanAperiodicHash(vertex);
    return _OceanFftSpatial.SampleLevel(sampler_OceanFftSpatial, float3(uv, slice), 0).y;
}

float OceanParticleCascadeHeight(float2 worldXZ, float domain, float slice)
{
    if (_OceanAperiodicParams.x <= 0.5)
        return _OceanFftSpatial.SampleLevel(sampler_OceanFftSpatial, float3(worldXZ / domain, slice), 0).y;

    OceanAperiodicTriangle tileTriangle = OceanAperiodicTriangleAt(worldXZ / domain, _OceanAperiodicParams.y);
    float3 weights = OceanAperiodicVarianceWeights(tileTriangle.weights);
    return OceanParticleTileHeight(worldXZ, domain, slice, tileTriangle.vertex0) * weights.x
         + OceanParticleTileHeight(worldXZ, domain, slice, tileTriangle.vertex1) * weights.y
         + OceanParticleTileHeight(worldXZ, domain, slice, tileTriangle.vertex2) * weights.z;
}
#endif

// ---------------------------------------------------------------- helpers
int2 ClampTexel(int2 p) { return clamp(p, int2(0, 0), int2((int)_Size - 1, (int)_Size - 1)); }

// Claim a pool slot WITHOUT stomping a living particle: advance the ring cursor and take
// the first dead slot among SLOT_CLAIM_PROBES probes; all-alive probes = the pool is
// saturated, so the caller drops the spawn. Each probe consumes a unique cursor value
// (InterlockedAdd), so concurrent claimants never contend for the same slot within a
// frame's normal range; the rare same-frame wrap collision writes one spawn over another
// FRESH spawn - the same soft-cap spirit as the frame budgets, never a mid-life kill.
bool ClaimPoolSlot(out uint slot)
{
    for (uint probe = 0u; probe < SLOT_CLAIM_PROBES; probe++)
    {
        uint cursor;
        InterlockedAdd(Counters[COUNTER_RING_CURSOR], 1, cursor);
        slot = cursor & (_Capacity - 1u); // capacity is a power of two
        if (Particles[slot].life <= 0.0) return true;
    }
    slot = 0u;
    return false;
}

// Pcg/Rand01 come from WaterParticleCommon.hlsl.

// World-lattice key of a spawn candidate. Two window texels that cover the same world
// cell make the SAME rolls, and a texel keeps its rolls while the window glides under
// it - the emission pattern is anchored to the water, not the camera.
uint2 WorldSpawnKey(float2 worldXZ)
{
    float cellMeters = max(sqrt(_TexelWorldArea), SPAWN_CELL_MIN_METERS);
    return (uint2)(int2)floor(worldXZ / cellMeters); // negative cells wrap deterministically
}

// Normalised sim-frame coords (.xz in [-1,1]) of a world point: window frame when
// windowed, else the whole pool. Mirrors the fcoord convention of WaterSurface.
float2 WorldToSimNorm(float3 world)
{
    return (_SimWindowed < 0.5) ? WorldToPool(world).xz : WorldToSim(world).xz;
}

// World position of a sim texel centre on the surface plane (y = 0).
float3 TexelToWorld(int2 texel)
{
    float2 norm = ((float2(texel) + 0.5) / _Size) * 2.0 - 1.0;
    if (_SimWindowed < 0.5)
        return PoolToWorld(float3(norm.x, 0.0, norm.y));
    return _SimCenter + mul(VolumeRot(), float3(norm.x, 0.0, norm.y) * SimExtentSafe());
}

// Manual bilinear fetch of the sim state at normalised frame coords.
float4 SampleSim(float2 simNorm)
{
    float2 st = (simNorm * 0.5 + 0.5) * _Size - 0.5;
    int2   s0 = (int2)floor(st);
    float2 t  = st - float2(s0);
    float4 c00 = Sim.Load(int3(ClampTexel(s0 + int2(0, 0)), 0));
    float4 c10 = Sim.Load(int3(ClampTexel(s0 + int2(1, 0)), 0));
    float4 c01 = Sim.Load(int3(ClampTexel(s0 + int2(0, 1)), 0));
    float4 c11 = Sim.Load(int3(ClampTexel(s0 + int2(1, 1)), 0));
    return lerp(lerp(c00, c10, t.x), lerp(c01, c11, t.x), t.y);
}

float2 SampleHorizontalFlow(float2 simNorm)
{
    float2 st = (simNorm * 0.5 + 0.5) * _Size - 0.5;
    int2 s0 = (int2)floor(st);
    float2 t = st - float2(s0);
    float2 c00 = SimHorizontalFlow.Load(int3(ClampTexel(s0 + int2(0, 0)), 0));
    float2 c10 = SimHorizontalFlow.Load(int3(ClampTexel(s0 + int2(1, 0)), 0));
    float2 c01 = SimHorizontalFlow.Load(int3(ClampTexel(s0 + int2(0, 1)), 0));
    float2 c11 = SimHorizontalFlow.Load(int3(ClampTexel(s0 + int2(1, 1)), 0));
    return lerp(lerp(c00, c10, t.x), lerp(c01, c11, t.x), t.y);
}

float3 HorizontalFlowWorld(float2 localFlow)
{
    return mul(VolumeRot(), float3(localFlow.x, 0.0, localFlow.y));
}

// Smooth value noise from the shared PCG hash (no texture needed at particle counts):
// hashed lattice corners, hermite-blended. Range [0,1).
float FoamValueNoise(float2 p)
{
    float2 cell = floor(p);
    float2 f = p - cell;
    f = f * f * (3.0 - 2.0 * f);
    uint2 c = (uint2)(int2)cell; // negative cells wrap deterministically
    float n00 = Rand01(c, 0x51ED270Bu);
    float n10 = Rand01(c + uint2(1u, 0u), 0x51ED270Bu);
    float n01 = Rand01(c + uint2(0u, 1u), 0x51ED270Bu);
    float n11 = Rand01(c + uint2(1u, 1u), 0x51ED270Bu);
    return lerp(lerp(n00, n10, f.x), lerp(n01, n11, f.x), f.y);
}

// Central-difference gradient of the value noise (noise-space units).
float2 FoamNoiseGrad(float2 p)
{
    const float eps = 0.25;
    float gx = FoamValueNoise(p + float2(eps, 0.0)) - FoamValueNoise(p - float2(eps, 0.0));
    float gy = FoamValueNoise(p + float2(0.0, eps)) - FoamValueNoise(p - float2(0.0, eps));
    return float2(gx, gy) / (2.0 * eps);
}

// Project a world position through the camera. Returns false when behind the camera.
// uv is OUR OWN convention (ndc * 0.5 + 0.5, no platform flip): the density composite
// derives its uv from the SAME ndc math, so the two sides agree on every backend by
// construction. eyeDepth = clip.w (linear metres, perspective).
bool ProjectToScreen(float3 world, out float2 uv, out float eyeDepth)
{
    float4 clip = mul(_DensityViewProj, float4(world, 1.0));
    uv = 0.0; eyeDepth = 0.0;
    if (clip.w <= 1e-4) return false;
    uv = (clip.xy / clip.w) * 0.5 + 0.5;
    eyeDepth = clip.w;
    return true;
}

// ---- Layer A shore field for the surf-lip spray. The uniforms, textures and the raw
// fail-fast fetch live in WaterParticleCommon.hlsl;
// the shoal math (ShoalWeight + its _ShoreShoalDepth knob) comes with it from
// WaterShoreMath.hlsl - the shared implementation that replaced this file's ShoalWeightSim.

// One shore-field fetch + the canonical front evaluation at a world xz. Inert (deep water, zero
// influence, zero surf) off-field or while the shore layer is off - callers can use the outputs
// unconditionally. Built on the shared fail-fast fetch: a degenerate SDF direction is now inert
// here too, matching the roller (the old local copy pressed on with toShore = 0).
SurfWaveSample SurfSampleAt(float2 worldXZ, out float shoreDepth, out float shoreInfluence,
                            out float2 toShore)
{
    float sdfDist, tanBeta;
    if (!ParticleSampleShoreField(worldXZ, shoreDepth, sdfDist, toShore, tanBeta, shoreInfluence))
        return SurfWaveSampleInert();
    return EvaluateSurfWaves(worldXZ, shoreDepth, sdfDist, toShore, tanBeta, shoreInfluence,
                             _ShoreFoamTime);
}

// World-space surface height under a floating particle: the same "glue to the animated
// surface" the quad vertex does, minus the small analytic wind-wave layer (cm-scale;
// compute has no wave globals). Pond: sim heightfield. Ocean: summed FFT cascades.
// Weight of the sim's ripple at these window coords, mirroring WaterSurfaceVertStage's
// SampleRipple: 1 inside, ramping to 0 over the last _SimEdgeFadeTexels, and 0 outside the window
// entirely. WITHOUT this the particles rode the FULL-amplitude heightfield while the drawn surface
// was already fading to flat, so through the band the two disagreed by up to the ripple's whole
// amplitude - particles left below the rendered water are depth-culled, which reads as the foam
// being cut in an arc that moves when the window is resized. Past the window it is worse than a
// mismatch: SampleSim clamps, so an outside particle silently reads the border texel's height.
// Whole-body bodies have no window and no band, so this returns 1 and they stay byte-identical.
float SimWindowRippleFade(float2 simNorm)
{
    if (_SimWindowed < 0.5) return 1.0;

    float2 uv = simNorm * 0.5 + 0.5;
    if (any(uv < 0.0) || any(uv > 1.0)) return 0.0;

    float band = max(_SimEdgeFadeTexels, 0.0) / max(_Size, 1.0); // texels -> normalised
    float2 edgeDist = min(uv, 1.0 - uv);
    return saturate(min(edgeDist.x, edgeDist.y) / max(band, 1e-5));
}

// Largest ripple height (POOL units) the glue will trust; see the twin in FoamParticles.shader.
// min/max rather than isfinite, matching the render side - it flushes NaN to the bound.
#define FOAM_RIPPLE_MAX_POOL_HEIGHT 1.0

float FoamRippleHeightSafe(float rawPoolHeight)
{
    return min(max(rawPoolHeight, -FOAM_RIPPLE_MAX_POOL_HEIGHT), FOAM_RIPPLE_MAX_POOL_HEIGHT);
}

// The interactive ripple under a particle, in WORLD metres: pool-unit sim height, faded at the
// window border, hardened, scaled by the volume's vertical extent. Shared by both surface
// branches - the OCEAN one adds it ON TOP of the swell, exactly as the surface mesh does.
float RippleGlueWorldHeight(float2 simNorm)
{
    float fade = SimWindowRippleFade(simNorm);
    if (fade <= 0.0) return 0.0; // outside the window: analytic-only water, no ripple

    return FoamRippleHeightSafe(SampleSim(simNorm).r) * fade * VolumeExtentSafe().y;
}

// Match FoamParticles.shader exactly: evaluate the wind-wave layer in its authoritative
// pool/world coordinate, then transform the pool-space height delta into world Y.
float WindWaveGlueWorldHeight(float2 worldXZ)
{
    if (_WaveCount < 0.5) return 0.0;

    float3 poolAtRest = WorldToPool(float3(worldXZ.x, _VolumeCenter.y, worldXZ.y));
    float windHeightPool = WaveHeight(WindWaveSampleXZ(poolAtRest.xz, worldXZ));
    return PoolToWorld(float3(poolAtRest.x, poolAtRest.y + windHeightPool, poolAtRest.z)).y
         - PoolToWorld(poolAtRest).y;
}

float SurfaceWorldY(float3 worldPos, float2 simNorm)
{
    float surfaceY;
    // Coastline: the rendered surface shoals the swell near shore, fades it under the surf
    // fronts and adds the fronts on top - the density glue must do the same or shore-zone foam
    // rasterizes at the un-shoaled open-water height (mirrors the shader's FFT branch of
    // LargeBodyWaveHeight, built from the shared WaterShoreMath/WaterSurfWaves functions).
    // Inert off-shore.
    float shoreDepth;
    float shoreInfluence;
    float2 toShoreUnused;
    SurfWaveSample surfGlue = SurfSampleAt(worldPos.xz, shoreDepth, shoreInfluence, toShoreUnused);
#ifdef OCEAN_FFT_GLUE
    float height = 0.0;
    for (int c = 0; c < OCEAN_FFT_MAX_CASCADES; c++)
    {
        float active = (c < (int)_OceanFftCascadeCount) ? 1.0 : 0.0;
        float slice = min((float)c, _OceanFftCascadeCount - 1.0);
        float domain = max(_OceanFftDomainSizes[c], 1e-3);
        float cascadeShoal = lerp(1.0, ShoalWeight(shoreDepth,
                                                   domain * OCEAN_FFT_CASCADE_WAVELENGTH_FRACTION),
                                  shoreInfluence);
        float fetch = SeaStateFetchWeight(worldPos.xz,
            domain * OCEAN_FFT_CASCADE_WAVELENGTH_FRACTION);
        height += active * cascadeShoal * fetch
                * OceanParticleCascadeHeight(worldPos.xz, domain, slice);
    }
    // The wake/interactive ripple rides ON TOP of the swell on oceans too (the surface mesh adds
    // both), so the density glue must - otherwise the veil sits at swell height inside a wake that
    // has lifted the water above it and the foam is depth-culled out of its own wake.
    surfaceY = _VolumeCenter.y
             + height * _OceanFftAmplitude * SurfAmbientWeight(surfGlue.mask)
             + surfGlue.height
             + RippleGlueWorldHeight(simNorm);
#else
    // Sim height is stored in pool units; the volume's vertical extent maps it to metres.
    // The surf fronts ride on top (they are analytic surface geometry, not sim state).
    surfaceY = _VolumeCenter.y + RippleGlueWorldHeight(simNorm) + surfGlue.height;
#endif
    return surfaceY + WindWaveGlueWorldHeight(worldPos.xz);
}

// ---------------------------------------------------------------- kernels
// Clears the spray tile budget; thread 0 also resets the per-frame spawn counter. The group size is
// the shared UPDATE_THREAD_GROUP_SIZE because the C# side divides by that same constant
// (WaterFoamParticles: TileCount / UpdateThreadGroupSize) - a literal here would silently zero only
// part of the tile grid the day that constant is retuned.
[numthreads(UPDATE_THREAD_GROUP_SIZE, 1, 1)]
void BeginFrame(uint3 id : SV_DispatchThreadID)
{
    if (id.x == 0)
    {
        Counters[COUNTER_FRAME_SPAWNS] = 0;
        Counters[COUNTER_BURST_SPAWNS] = 0;
        Counters[COUNTER_CREST_FLECK_SPAWNS] = 0;
    }
    if (id.x < TILE_GRID * TILE_GRID) TileCounts[id.x] = 0;
}

bool TryClaimAmbientSlot(out uint slot)
{
    uint frameSpawns;
    InterlockedAdd(Counters[COUNTER_FRAME_SPAWNS], 1, frameSpawns);
    if (frameSpawns >= _MaxSpawnPerFrame)
    {
        slot = 0u;
        return false;
    }
    return ClaimPoolSlot(slot);
}

bool TryClaimRippleCrestFleckSlot(out uint slot)
{
    uint crestFleckSpawns;
    InterlockedAdd(Counters[COUNTER_CREST_FLECK_SPAWNS], 1, crestFleckSpawns);
    if (crestFleckSpawns >= _RippleCrestFleckMaxPerFrame)
    {
        slot = 0u;
        return false;
    }

    // Own budget, own pool claim: routing through TryClaimAmbientSlot made crest flecks ALSO
    // consume the ambient _MaxSpawnPerFrame budget, so on a foamy body the two sources starved
    // each other and crest rings showed missing dots. The pool ring still arbitrates fairly
    // (dead-slot probes only) - saturation drops spawns, never kills live foam.
    return ClaimPoolSlot(slot);
}

bool TryGetRippleCrestFleckCandidate(int2 texel, float3 texelWorld, out float crestStrength,
                                     out float2 localFlow, out float foamSourced)
{
    crestStrength = 0.0;
    localFlow = 0.0;
    foamSourced = 0.0;
    if (_RippleCrestFlecksEnabled <= 0.5 || _RippleCrestFleckAmount <= 0.0) return false;

    float4 info = Sim.Load(int3(texel, 0));
    float rippleFade = SimWindowRippleFade(WorldToSim(texelWorld).xz);
    float metresPerPoolHeight = VolumeExtentSafe().y;
    float crestHeight = FoamRippleHeightSafe(info.r) * rippleFade * metresPerPoolHeight;

    float2 flow = SimHorizontalFlow.Load(int3(texel, 0));
    // Round 2's universal flow gate here was WRONG, and it is why the primary ring carried no
    // flecks: the passive flow layer BUILDS UP behind a first-arrival crest (~0.001 m/s per
    // step from -g*grad(h)*dt), so the 0.01 m/s bar rejected exactly the leading front and
    // accepted only the wake behind it - dust inside the ring, nothing ON it. The crest path
    // now spawns regardless of flow (the spawn direction is epsilon-guarded); only the
    // foam-mask RE-EMISSION path below still requires transport.
    bool hasLiveFlow = dot(flow, flow) >= CREST_FLECK_MIN_FLOW_SPEED_SQUARED;

    // Foam-mask feedback path (KWS OR-acceptance): the sim's advected, slowly-decaying foam
    // mask keeps this texel emitting after the crest that churned it has passed. Faded by the
    // same window fade as the crest height so the two paths agree at the sim border.
    float foamMask = FoamTex.Load(int3(texel, 0)) * rippleFade;
    float foamStrength = saturate((foamMask - CREST_FLECK_FOAM_MASK_MIN)
                                  / CREST_FLECK_FOAM_MASK_RANGE)
                       * CREST_FLECK_FOAM_MASK_WEIGHT;
    // Re-emission without transport would freeze into the inactive fade next frame - the
    // foam-mask source keeps the flow requirement the crest path just dropped.
    if (!hasLiveFlow) foamStrength = 0.0;

    bool crestCandidate = crestHeight > CREST_FLECK_MIN_HEIGHT_METERS;
    if (!crestCandidate && foamStrength <= 0.0) return false;

    float heightStrength = 0.0;
    if (crestCandidate)
    {
        // WIDE (+/-2) peakness stencil - the sim foam generation's own anti-noise trick:
        // grid-frequency chop alternates sign texel-to-texel, so it reads FLAT at this scale
        // and never qualifies as a crest, while a real ring front (several texels wide)
        // keeps its full peak signal. The +/-1 stencil scored the chop HIGHER than the ring.
        float4 leftInfo = Sim.Load(int3(ClampTexel(texel + int2(-2, 0)), 0));
        float4 rightInfo = Sim.Load(int3(ClampTexel(texel + int2( 2, 0)), 0));
        float4 downInfo = Sim.Load(int3(ClampTexel(texel + int2(0, -2)), 0));
        float4 upInfo = Sim.Load(int3(ClampTexel(texel + int2(0,  2)), 0));

        float neighbourAverageHeight = (leftInfo.r + rightInfo.r + downInfo.r + upInfo.r) * 0.25;
        float positivePeakHeight = max(0.0, info.r - neighbourAverageHeight);
        float localAmplitude = max(abs(info.r), CREST_FLECK_MIN_LOCAL_AMPLITUDE);
        float peakness = positivePeakHeight / localAmplitude;
        if (peakness > CREST_FLECK_PEAKNESS_MIN)
            heightStrength = saturate((crestHeight - CREST_FLECK_MIN_HEIGHT_METERS)
                                      / CREST_FLECK_HEIGHT_RANGE_METERS);

        // FRONT-COHERENCE gate (see the constant block): computed on the sim's own vertical
        // velocity, so the discriminator needs no flow-layer reads. The +-2 taps reuse the
        // peakness loads; +-4/+-6 extend the cross to the trailing-train wavelength.
        if (heightStrength > 0.0)
        {
            float4 left4Info = Sim.Load(int3(ClampTexel(texel + int2(-4, 0)), 0));
            float4 right4Info = Sim.Load(int3(ClampTexel(texel + int2( 4, 0)), 0));
            float4 down4Info = Sim.Load(int3(ClampTexel(texel + int2(0, -4)), 0));
            float4 up4Info = Sim.Load(int3(ClampTexel(texel + int2(0,  4)), 0));
            float4 left6Info = Sim.Load(int3(ClampTexel(texel + int2(-6, 0)), 0));
            float4 right6Info = Sim.Load(int3(ClampTexel(texel + int2( 6, 0)), 0));
            float4 down6Info = Sim.Load(int3(ClampTexel(texel + int2(0, -6)), 0));
            float4 up6Info = Sim.Load(int3(ClampTexel(texel + int2(0,  6)), 0));
            float signedSum = info.g
                            + leftInfo.g + rightInfo.g + downInfo.g + upInfo.g
                            + left4Info.g + right4Info.g + down4Info.g + up4Info.g
                            + left6Info.g + right6Info.g + down6Info.g + up6Info.g;
            float absSum = abs(info.g)
                         + abs(leftInfo.g) + abs(rightInfo.g) + abs(downInfo.g) + abs(upInfo.g)
                         + abs(left4Info.g) + abs(right4Info.g) + abs(down4Info.g) + abs(up4Info.g)
                         + abs(left6Info.g) + abs(right6Info.g) + abs(down6Info.g) + abs(up6Info.g);
            float frontCoherence = abs(signedSum)
                                 / max(absSum, CREST_FLECK_COHERENCE_ABS_EPS);
            heightStrength *= smoothstep(CREST_FLECK_COHERENCE_LO, CREST_FLECK_COHERENCE_HI,
                                         frontCoherence);
        }
    }

    crestStrength = max(heightStrength, foamStrength);
    if (crestStrength <= 0.0) return false;
    // A live crest owns the texel; only crest-less foam re-emission is treated as the
    // sparser, smaller-cluster foam-mask source (see the FOAM_SOURCE constants).
    foamSourced = (heightStrength > 0.0) ? 0.0 : 1.0;
    localFlow = flow;
    return true;
}

float3 CrestFleckJitterWorld(int2 texel, uint spawnIndex)
{
    uint spawnSeed = _FrameSeed ^ CREST_FLECK_CLUSTER_SEED ^ spawnIndex;
    float2 jitter = float2(Rand01((uint2)texel, spawnSeed),
                           Rand01((uint2)texel, spawnSeed ^ 0x9E3779B9u)) - 0.5;
    float2 normalizedTexelJitter = jitter * (CREST_FLECK_CLUSTER_OFFSET_TEXELS * 2.0 / _Size);
    float3 localOffset = float3(normalizedTexelJitter.x, 0.0, normalizedTexelJitter.y)
                       * (_SimWindowed < 0.5 ? VolumeExtentSafe() : SimExtentSafe());
    return mul(VolumeRot(), localOffset);
}

bool TrySpawnRippleCrestFlecks(int2 texel, float3 texelWorld, float crestStrength,
                               float2 localFlow, float foamSourced)
{

    float clusterStrength = saturate(crestStrength * _RippleCrestFleckAmount);
    // Crest sources select often (dense dots ON the crest); foam-mask re-emission stays sparse.
    float sourceSelectionChance = lerp(CREST_FLECK_SOURCE_SELECTION_CHANCE,
                                       CREST_FLECK_FOAM_SOURCE_SELECTION_CHANCE, foamSourced);
    float probability = clusterStrength * sourceSelectionChance;
    // Stochastic distance LOD (KWS): fleck emission thins beyond the plateau of the spawn
    // range. The crest path had NO distance falloff, so the camera-following window filled
    // the whole view with equal-density dots at every distance - the "dispatched everywhere"
    // read. Same plateau/keep-alive constants as the ambient path; 0 = LOD off (no camera).
    if (_SpawnMaxDistance > 0.0)
    {
        float distanceNorm = saturate(distance(texelWorld.xz, _SpawnCameraXZ)
                                      / _SpawnMaxDistance);
        float distanceThinning = smoothstep(SPAWN_LOD_PLATEAU, 1.0, distanceNorm);
        probability *= saturate(1.0 - distanceThinning + SPAWN_LOD_KEEP_ALIVE);
    }
    // Unlike ambient foam, ripple flecks use a per-texel roll (the same KWS idiom). The generic
    // world-cell key has a 0.25 m floor, so it selects whole square chunks of a small ripple and
    // leaves visible gaps around the ring.
    if (Rand01((uint2)texel, _FrameSeed ^ 0x7F4A7C15u) >= probability) return false;
    if (_ExclusionCount > 0.5 && InsideParticleExclusion(texelWorld)) return false;

    // Epsilon keeps the direction finite for a leading crest whose flow hasn't built yet.
    float2 flowDirection = normalize(localFlow + float2(0.0, CREST_FLECK_FLOW_EPSILON));
    float2 perpendicularDirection = float2(-flowDirection.y, flowDirection.x);
    float3 flowWorld = HorizontalFlowWorld(localFlow);
    float2 texelWorldSize = SimExtentSafe().xz * (2.0 / _Size);
    uint spawnCount = min(max(1u, (uint)ceil(clusterStrength
                                               * CREST_FLECK_CLUSTER_STRENGTH_MULTIPLIER)),
                          CREST_FLECK_MAX_SPAWNS_PER_TEXEL);
    if (foamSourced > 0.5)
        spawnCount = min(spawnCount, CREST_FLECK_FOAM_MAX_SPAWNS_PER_TEXEL);
    bool spawned = false;
    // KWS turns stronger dynamic-wave cells into a compact cluster, rather than merely raising
    // the odds of one point. The jitter keeps that cluster on the source texel instead of making
    // a grid of duplicates at its centre.
    for (uint spawnIndex = 0u; spawnIndex < spawnCount; spawnIndex++)
    {
        uint slot;
        if (!TryClaimRippleCrestFleckSlot(slot)) return spawned;

        uint spawnSeed = _FrameSeed ^ CREST_FLECK_CLUSTER_SEED ^ spawnIndex;
        float r0 = Rand01((uint2)texel, spawnSeed ^ 0xA24BAED5u);
        float r1 = Rand01((uint2)texel, spawnSeed ^ 0x9FB21C65u);
        FoamParticle particle;
        float lateralRoll = Rand01((uint2)texel, spawnSeed ^ 0xD1B54A35u) * 2.0 - 1.0;
        float behindRoll = Rand01((uint2)texel, spawnSeed ^ 0x94D049BBu);
        float2 flowOffset = perpendicularDirection * lateralRoll * CREST_FLECK_LATERAL_SPREAD_TEXELS
                          - flowDirection * behindRoll * CREST_FLECK_BEHIND_FLOW_TEXELS;
        float3 localOffset = float3(flowOffset.x * texelWorldSize.x, 0.0,
                                    flowOffset.y * texelWorldSize.y);
        particle.worldPos = texelWorld + CrestFleckJitterWorld(texel, spawnIndex)
                          + mul(VolumeRot(), localOffset);
        particle.worldPos.y = 0.0;
        particle.velocity = flowWorld * _RippleCrestFleckMotion;
        particle.age = 0.0;
        particle.life = lerp(_RippleCrestFleckLifeMin, _RippleCrestFleckLifeMax, r0)
                      * CREST_FLECK_LIFE_MULTIPLIER;
        particle.size = lerp(_RippleCrestFleckSizeMin, _RippleCrestFleckSizeMax, r1);
        particle.seed = r1;
        particle.kind = KIND_RIPPLE_CREST;
        particle.strength = crestStrength;
        particle.opacity = 1.0;
        Particles[slot] = particle;
        CrestFleckPreviousPositions[slot] = particle.worldPos;
        spawned = true;
    }
    return spawned;
}

// One thread per sim texel: roll a spawn where foam exceeds the threshold. The
// probability is normalised by the texel's world area, so particle density (per
// square metre of foamy water) is independent of grid resolution and body size.
[numthreads(SPAWN_THREAD_GROUP_SIZE, SPAWN_THREAD_GROUP_SIZE, 1)]
void Spawn(uint3 id : SV_DispatchThreadID)
{
    int2 texel = int2(id.xy);
    float3 texelWorld = TexelToWorld(texel);
    uint2 spawnKey = WorldSpawnKey(texelWorld.xz);

    // Ripple-crest flecks spawn on EVERY body kind. The OCEAN_FFT_GLUE variant used to compile
    // this block out along with the ambient gate, which silently meant "no wake flecks on any
    // FFT ocean" - the exact scene KWS is judged against. Only AMBIENT spawning stays
    // ocean-gated (below); this kind reads the ripple sim, which runs on oceans too (wakes).
    float crestStrength;
    float2 crestLocalFlow;
    float crestFoamSourced;
    bool isRippleCrest = TryGetRippleCrestFleckCandidate(texel, texelWorld, crestStrength,
                                                          crestLocalFlow, crestFoamSourced);
    if (isRippleCrest)
    {
        TrySpawnRippleCrestFlecks(texel, texelWorld, crestStrength, crestLocalFlow,
                                  crestFoamSourced);
    }

    float foam = FoamTex.Load(int3(texel, 0));
    float excess = foam - _SpawnThreshold;
    if (excess <= 0.0) return;

    // Stochastic distance LOD (KWS): spawn probability falls with camera distance. The
    // LOD ticket is FIXED per world cell (no frame seed): as the camera moves, each cell
    // switches on/off at its own stable distance instead of the whole density blob being
    // re-rolled around the camera every frame. The plateau keeps density FULL out to
    // SPAWN_LOD_PLATEAU of the range - inside it, camera motion changes nothing at all -
    // and the shoulder then thins smoothly to the keep-alive dusting beyond the range.
    if (_SpawnMaxDistance > 0.0)
    {
        float distNorm = saturate(distance(texelWorld.xz, _SpawnCameraXZ) / _SpawnMaxDistance);
        float thinning = smoothstep(SPAWN_LOD_PLATEAU, 1.0, distNorm);
        float lodTicket = Rand01(spawnKey, 0x27D4EB2Du);
        if (lodTicket + SPAWN_LOD_KEEP_ALIVE < thinning) return;
    }

    // Shear boost: wake edges / interactor rims (where moving water borders still water)
    // emit more than uniformly-moving patches. Same measure the sim's foam gen uses.
    float vL = Sim.Load(int3(ClampTexel(texel + int2(-1, 0)), 0)).g;
    float vR = Sim.Load(int3(ClampTexel(texel + int2( 1, 0)), 0)).g;
    float vD = Sim.Load(int3(ClampTexel(texel + int2( 0,-1)), 0)).g;
    float vU = Sim.Load(int3(ClampTexel(texel + int2( 0, 1)), 0)).g;
    float shear = length(float2(vR - vL, vU - vD)) * 0.5;

    float probability = excess * (1.0 + shear * SPAWN_SHEAR_BOOST)
                      * _SpawnRate * _TexelWorldArea * _DeltaTime;
    // World-keyed roll (frame seed keeps the temporal churn): the accept/reject decision
    // for a given patch of water no longer flickers as the window slides across it.
    if (Rand01(spawnKey, _FrameSeed) >= probability) return;

    // Never born inside a dry volume (a boat hull): the Update kernel would fade it out
    // right away, so spawning there is at best a one-frame flash. Post-roll (spawning
    // texels only) and gated on the volume count, so volume-free scenes pay nothing.
    // texelWorld.y is the surface-plane height - close enough against people-sized boxes.
    if (_ExclusionCount > 0.5 && InsideParticleExclusion(texelWorld)) return;

    uint slot;
    if (!TryClaimAmbientSlot(slot)) return; // pool saturated: drop the spawn, never kill live foam

    float4 info = Sim.Load(int3(texel, 0));
    float r0 = Rand01(id.xy, _FrameSeed ^ 0x9E3779B9u);
    float r1 = Rand01(id.xy, _FrameSeed ^ 0x85EBCA6Bu);
    float r2 = Rand01(id.xy, _FrameSeed ^ 0xC2B2AE35u);

#ifdef OCEAN_FFT_GLUE
    // Ocean/shore bodies spawn NOTHING from this ambient kernel - by request: no turbulence-foam
    // sprites on the swell or on shore waves (they read as flat billboards), and the procedural
    // surf-lip droplets are gone too - the breaking-wave look waits for authored splash sprites
    // in the droplet material slot. Splash / pump BURSTS (and their bubbles) still spawn.
    // An unwritten claimed slot stays dead, so bailing here never strands a live particle.
    return;
#endif

    bool spray = r0 < _SprayChance;

    // Per-screen-tile spray budget (KWS): spray clumping in one screen region is capped by
    // reserving a slot in a coarse tile grid; over-budget spawns demote to floating foam
    // rather than being lost. Offscreen spawns skip the budget (they cost no overdraw).
    if (spray && _TileBudgetEnabled > 0.5)
    {
        float2 uv; float eyeDepth;
        if (ProjectToScreen(texelWorld, uv, eyeDepth) && all(uv >= 0.0) && all(uv <= 1.0))
        {
            uint2 tile = min((uint2)(uv * TILE_GRID), TILE_GRID - 1);
            uint before;
            InterlockedAdd(TileCounts[tile.y * TILE_GRID + tile.x], 1, before);
            if (before >= _SprayTileCap) spray = false;
        }
    }

    // Surface flow: normal.xz = -gradient(height) = downhill = flow direction.
    float3 flowWorld = mul(VolumeRot(), float3(info.b, 0.0, info.a)) * _FlowDrift;

    FoamParticle particle;
    particle.worldPos = texelWorld;
    particle.worldPos.y = 0.0;
    particle.velocity = flowWorld + float3(_WindDrift.x, 0.0, _WindDrift.y);
    if (spray) particle.velocity.y = _SprayLaunchSpeed * (0.6 + 0.4 * r1);
    // Surf lip jet: throw shoreward along the point's own toward-shore direction; gravity arcs
    // the droplets onto the splash-down zone, where landing converts them to floating churn.
    particle.age = 0.0;
    // Spray and floating foam draw their lifetime/size from separate ranges (KIND split).
    float lifeMin = spray ? _SprayLifeMin : _LifeMin;
    float lifeMax = spray ? _SprayLifeMax : _LifeMax;
    particle.life = lerp(lifeMin, lifeMax, r1);
    // Hero-size distribution (KWS): pow biases the roll small, so a few rare sprites land
    // near the max and read as hero clumps. _SizeHeroPower 1 = the original uniform sizes.
    float sizeMin = spray ? _SpraySizeMin : _SizeMin;
    float sizeMax = spray ? _SpraySizeMax : _SizeMax;
    particle.size = lerp(sizeMin, sizeMax, pow(r2, _SizeHeroPower));
    particle.seed = r2;
    particle.kind = spray ? KIND_SPRAY : KIND_SURFACE;
    particle.strength = saturate(foam);
    particle.opacity = 1.0;
    Particles[slot] = particle;
}

// Turns a droplet's outward/up speed pair into a velocity, lifted by the burst's elevation.
//
// The rotation happens AFTER the per-droplet jitter, so the natural spread in launch angle is
// preserved and simply swung as a whole. It also preserves SPEED: tilting changes where a droplet
// goes, never how hard it was thrown - which is what keeps the tilt independent of the emitter's
// Upward Bias instead of fighting it.
//
// A zero elevation takes the original line verbatim rather than round-tripping through atan2/sin/cos,
// because that round trip is not bit-exact and every pre-tilt burst has to stay exactly as it was.
float3 Elevate(float2 dir, float outSpeed, float upSpeed, float elevationRadians)
{
    if (abs(elevationRadians) < BURST_ELEVATION_MIN)
        return float3(dir.x * outSpeed, upSpeed, dir.y * outSpeed);

    float speed = length(float2(outSpeed, upSpeed));
    float elevation = clamp(atan2(upSpeed, outSpeed) + elevationRadians, 0.0, BURST_MAX_ELEVATION);
    float horizontal = cos(elevation) * speed;
    return float3(dir.x * horizontal, sin(elevation) * speed, dir.y * horizontal);
}

// One thread group per CPU-queued burst request, one thread per droplet candidate: throws
// KIND_SPRAY droplets on a ring around an impact (rigidbody splash, mouse splash). They
// integrate ballistically in Update and land as surface foam, so event splashes share the
// exact tech + look of turbulence-thrown spray - the Shuriken system keeps only the crown.
[numthreads(MAX_BURST_DROPLETS, 1, 1)]
void SpawnBurst(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
    uint request = gid.x;
    if (request >= _BurstRequestCount) return;
    BurstRequest burst = BurstRequests[request];
    if ((float)tid.x >= burst.count) return;

    uint salt = (uint)(burst.seed * 4294967295.0);
    uint2 key = uint2(tid.x, request);
    float r0 = Rand01(key, salt);
    float r1 = Rand01(key, salt ^ 0x9E3779B9u);
    float r2 = Rand01(key, salt ^ 0x85EBCA6Bu);
    float r3 = Rand01(key, salt ^ 0xC2B2AE35u);

    // Petal arc: narrow the ring to a wedge centred on the burst's own direction. burst.* is
    // per-REQUEST, so this branch is uniform across the thread group - coherent, no divergence
    // cost - and a zero direction takes the original full-ring line unchanged.
    float2 petal = float2(burst.dirX, burst.dirZ);
    float angle = (dot(petal, petal) < BURST_DIR_MIN_SQ)
        ? r0 * 6.2831853
        : atan2(petal.y, petal.x) + (r0 * 2.0 - 1.0) * burst.arcHalfRadians;
    float2 dir = float2(cos(angle), sin(angle));
    float ring = burst.radius * BURST_RING_RADIUS_SCALE * r1;
    float2 spawnXZ = burst.center.xz + dir * ring;

    // Never born inside a dry volume: a pump probe sitting at a hull edge spawns half its
    // ring inside the boat's exclusion box, and each of those droplets flashed for exactly
    // one frame before Update culled it - per-burst strobing at the bow. Tested at the
    // TRUE world height (burst.center.y is the surface), before any budget is consumed.
    if (_ExclusionCount > 0.5
        && InsideParticleExclusion(float3(spawnXZ.x, burst.center.y + BURST_SPAWN_HEIGHT, spawnXZ.y)))
        return;

    // Per-frame burst budget (count first, back out if over - the same soft-cap idiom as
    // Spawn): a storm of impact events can no longer flush a quarter-plus of the pool in
    // one frame. Own counter, so bursts never starve behind the turbulence budget.
    uint burstSpawns;
    InterlockedAdd(Counters[COUNTER_BURST_SPAWNS], 1, burstSpawns);
    if (burstSpawns >= _Capacity / BURST_FRAME_CAP_DIVISOR) return;

    uint slot;
    if (!ClaimPoolSlot(slot)) return; // pool saturated: drop the droplet, never kill live foam

    FoamParticle particle;
    particle.worldPos = float3(spawnXZ.x,
                               BURST_SPAWN_HEIGHT, // y = height ABOVE the local surface
                               spawnXZ.y);
    float outSpeed = burst.outSpeed * lerp(BURST_OUT_JITTER_MIN, BURST_OUT_JITTER_MAX, r2);
    float upSpeed = burst.upSpeed * lerp(BURST_UP_JITTER_MIN, BURST_UP_JITTER_MAX, r3);
    particle.velocity = Elevate(dir, outSpeed, upSpeed, burst.elevationRadians);
    particle.age = 0.0;
    // Burst droplets carry their OWN life/size in the request (from the WaterSplashEmitter),
    // so pump/impact splashes tune independently of the ambient-mist spray ranges.
    particle.life = lerp(burst.lifeMin, burst.lifeMax, r1);
    particle.size = burst.size
                  * lerp(BURST_SIZE_JITTER_MIN, BURST_SIZE_JITTER_MAX, pow(r2, _SizeHeroPower));
    particle.seed = r0;
    particle.kind = KIND_SPRAY;
    particle.strength = saturate(burst.strength);
    particle.opacity = saturate(burst.dropletOpacity);
    Particles[slot] = particle;

    // ---- Bubble plume (KIND_BUBBLE): the same impact that throws droplets UP drives air
    // DOWN. The first _BubbleAmount fraction of the droplet threads also injects a bubble
    // just under the surface, moving downward; Update's buoyancy turns it around and pops
    // it back through the waterline as a deposited fleck. Shares the burst budget and the
    // droplet's ring position, so the plume sits under the splash that made it. ----
    if ((float)tid.x >= burst.count * _BubbleAmount) return;

    InterlockedAdd(Counters[COUNTER_BURST_SPAWNS], 1, burstSpawns);
    if (burstSpawns >= _Capacity / BURST_FRAME_CAP_DIVISOR) return;

    uint bubbleSlot;
    if (!ClaimPoolSlot(bubbleSlot)) return;

    FoamParticle bubble;
    bubble.worldPos = float3(spawnXZ.x, -BUBBLE_SPAWN_DEPTH, spawnXZ.y);
    bubble.velocity = float3(dir.x, 0.0, dir.y) * (outSpeed * BUBBLE_LATERAL_FACTOR);
    bubble.velocity.y = -upSpeed * BUBBLE_PLUNGE_FACTOR;
    bubble.age = 0.0;
    bubble.life = lerp(_BubbleLifeMin, _BubbleLifeMax, r1);
    bubble.size = lerp(_BubbleSizeMin, _BubbleSizeMax, pow(r3, BUBBLE_SIZE_SKEW));
    bubble.seed = r2;
    bubble.kind = KIND_BUBBLE;
    bubble.strength = saturate(burst.strength);
    bubble.opacity = 1.0;
    Particles[bubbleSlot] = bubble;
}


// Convert an airborne droplet or a surfaced bubble into a deposited surface fleck: the
// deposit is its OWN foam element, so the age restarts and life/size re-roll from the
// deposit ranges - tuned independently of the particle that made it. ONE implementation
// for both conversions (spray landing + bubble pop), per the reuse-never-rewrite rule.
void DepositFrom(inout FoamParticle particle, uint slot)
{
    uint2 depositKey = uint2(slot, asuint(particle.seed));
    particle.kind = KIND_SURFACE;
    particle.age = 0.0;
    particle.life = lerp(_DepositLifeMin, _DepositLifeMax,
                         Rand01(depositKey, _FrameSeed));
    particle.size = lerp(_DepositSizeMin, _DepositSizeMax,
                         Rand01(depositKey, _FrameSeed ^ 0x9E3779B9u));
    particle.opacity = 1.0;
}

// One thread per pool slot: integrate, convert landed spray (or a surfaced bubble) to
// surface foam, and kill particles that age out or leave the active sim frame.
[numthreads(UPDATE_THREAD_GROUP_SIZE, 1, 1)]
void Update(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _Capacity) return;

    FoamParticle particle = Particles[slot];
    if (particle.life <= 0.0) return;

    particle.age += _DeltaTime;

    float2 simNorm = WorldToSimNorm(particle.worldPos);
    float frameEdge = max(abs(simNorm.x), abs(simNorm.y));
    if (frameEdge > 1.0 + FRAME_KILL_MARGIN)
    {
        particle.life = 0.0;
        Particles[slot] = particle;
        return;
    }
    // Edge fade band: accelerate aging toward the frame edge so the life envelope fades
    // the particle out smoothly before the moving window's hard kill can cull it - the
    // sweep of that kill line was one of the "foam follows the camera" causes.
    float fadeStart = 1.0 - FRAME_FADE_BAND;
    if (frameEdge > fadeStart)
    {
        float edgeDepth = saturate((frameEdge - fadeStart) / (FRAME_FADE_BAND + FRAME_KILL_MARGIN));
        particle.age += _DeltaTime * edgeDepth * FRAME_FADE_AGE_BOOST;
    }

    if (particle.age >= particle.life) { particle.life = 0.0; Particles[slot] = particle; return; }

    // Dry-interior exclusion: foam riding (or spray arcing through) a dry room / boat hull
    // must go - the surface it would sit on is discarded there. But the old hard kill
    // (life = 0) popped sprites out in ONE frame, and a moving hull plows its box through
    // the bow spray it just threw, so the whole plume strobed. Instead the particle AGES
    // faster the deeper it intrudes (the window-edge fade idiom): a swept-over droplet
    // dissolves over a few tenths of a second, anything deep inside a dry room still
    // vanishes near-instantly. Gated on the volume count: volume-free scenes pay nothing.
    if (_ExclusionCount > 0.5)
    {
        // Stored y is a height offset ABOVE the local water surface; lift to true world Y.
        float3 exclusionProbe = particle.worldPos;
        exclusionProbe.y += SurfaceWorldY(particle.worldPos, simNorm);
        // x = interior depth among PARTICLE-AFFECTING volumes (per-volume opt-out honoured),
        // y = that volume's dissolve-speed multiplier (particleDissolveSpeed on the script).
        float2 interior = ExclusionParticleInteriorDepth(exclusionProbe);
        if (interior.x > 0.0)
        {
            float intrusion = saturate(interior.x / EXCLUSION_FADE_SHELL);
            particle.age += _DeltaTime * interior.y
                          * lerp(EXCLUSION_FADE_AGE_BOOST_MIN,
                                 EXCLUSION_FADE_AGE_BOOST_MAX, intrusion);
            if (particle.age >= particle.life)
            {
                particle.life = 0.0;
                Particles[slot] = particle;
                return;
            }
        }
    }

    if (particle.kind == KIND_SPRAY)
    {
        particle.velocity.y -= _Gravity * _DeltaTime;
        particle.worldPos += particle.velocity * _DeltaTime;
        if (particle.worldPos.y <= SPRAY_LANDING_EPSILON && particle.velocity.y < 0.0)
        {
            particle.worldPos.y = 0.0;
            particle.velocity = float3(particle.velocity.x, 0.0, particle.velocity.z) * SPRAY_LANDING_KEEP;
            DepositFrom(particle, slot);
        }
    }
    else if (particle.kind == KIND_BUBBLE)
    {
        // Buoyancy: exponential relax toward a size-scaled terminal rise (largest bubbles
        // fastest). A fresh plume is moving DOWN, so the same relax first brakes the plunge,
        // then rises it - the plume depth emerges from injection speed vs this response.
        float sizeNorm = saturate(particle.size / max(_BubbleSizeMax, 1e-4));
        float terminalRise = _BubbleRiseSpeed * lerp(BUBBLE_RISE_SIZE_MIN_FACTOR, 1.0, sizeNorm);
        particle.velocity.y = lerp(particle.velocity.y, terminalRise,
                                   saturate(BUBBLE_BUOYANCY_RESPONSE * _DeltaTime));
        // Sideways: relax toward the local surface flow (a bubble has next to no inertia)...
        float4 info = SampleSim(simNorm);
        float3 driven = mul(VolumeRot(), float3(info.b, 0.0, info.a)) * _FlowDrift;
        particle.velocity.xz = lerp(particle.velocity.xz, driven.xz, saturate(_Drag * _DeltaTime));
        particle.worldPos += particle.velocity * _DeltaTime;
        // ...plus the size-gated wobble, applied to POSITION so the amplitude is a real
        // speed instead of compounding through the velocity relax above.
        float2 wobbleGrad = FoamNoiseGrad(particle.worldPos.xz * BUBBLE_WOBBLE_SCALE
                                          + particle.seed * 37.0
                                          + particle.age * BUBBLE_WOBBLE_RATE);
        particle.worldPos.xz += wobbleGrad
                              * (_BubbleWobble * BUBBLE_WOBBLE_SPEED * sizeNorm * _DeltaTime);
        // Surfacing: the bubble's top breaks the waterline -> pop into a deposited fleck
        // (salt-water behavior; the fresh-water regime is a planned increment).
        if (particle.worldPos.y >= -particle.size)
        {
            particle.worldPos.y = 0.0;
            particle.velocity.y = 0.0;
            DepositFrom(particle, slot);
        }
    }
    else
    {
        // Relax the drift toward the driven velocity (local flow + wind): foam has
        // no inertia to speak of, but the relaxation keeps direction changes smooth.
        float4 info = SampleSim(simNorm);
        float3 driven = mul(VolumeRot(), float3(info.b, 0.0, info.a)) * _FlowDrift
                      + float3(_WindDrift.x, 0.0, _WindDrift.y);
        if (particle.kind == KIND_RIPPLE_CREST)
        {
            float3 liveRippleFlow = HorizontalFlowWorld(SampleHorizontalFlow(simNorm));
            float liveFlowSpeed = length(liveRippleFlow.xz);
            if (liveFlowSpeed <= CREST_FLECK_MIN_FLOW_SPEED_METERS_PER_SECOND)
            {
                // A long authored lifetime must not leave a static deposit once the wave that
                // created it has dissipated. KWS particles disappear with their active wave zone.
                particle.life = min(particle.life,
                                    particle.age + CREST_FLECK_INACTIVE_FLOW_FADE_SECONDS);
                particle.velocity = 0.0;
                CrestFleckPreviousPositions[slot] = particle.worldPos;
            }
            else
            {
                // Real solver flow stays dominant. Slope/wind remain an authored additive touch,
                // capped relative to live flow so they cannot turn a stopped ripple into drift.
                float authoredDriftSpeed = length(driven.xz);
                float maxAuthoredDriftSpeed = liveFlowSpeed
                                             * CREST_FLECK_AUTHORED_DRIFT_MAX_FLOW_FRACTION;
                if (authoredDriftSpeed > maxAuthoredDriftSpeed)
                    driven *= maxAuthoredDriftSpeed / authoredDriftSpeed;
                driven += liveRippleFlow * saturate(_RippleCrestFleckMotion);

                // Low-pass history spans roughly KWS's four-frame particle slice while retaining
                // full-rate physical advection. The renderer uses current-minus-history as trail axis.
                CrestFleckPreviousPositions[slot] = lerp(CrestFleckPreviousPositions[slot],
                                                          particle.worldPos,
                                                          saturate(_DeltaTime
                                                                   * CREST_FLECK_HISTORY_HERTZ));
            }
            if (liveFlowSpeed > CREST_FLECK_MIN_FLOW_SPEED_METERS_PER_SECOND)
            {
                float flowResponse = lerp(CREST_FLECK_FLOW_RESPONSE_MIN,
                                          CREST_FLECK_FLOW_RESPONSE_MAX, particle.seed);
                particle.velocity = lerp(particle.velocity, driven, flowResponse);
                particle.velocity.y = 0.0;
                particle.worldPos += particle.velocity * _DeltaTime;

                float2 planarFlow = liveRippleFlow.xz;
                float2 perpendicularFlow = float2(-planarFlow.y, planarFlow.x) / liveFlowSpeed;
                float noise = FoamValueNoise(particle.worldPos.xz * CREST_FLECK_UNDULATION_SCALE
                                              + particle.seed
                                              + particle.age * CREST_FLECK_UNDULATION_RATE);
                float signedNoise = noise * 2.0 - 1.0;
                particle.worldPos.xz += perpendicularFlow
                                      * (signedNoise * CREST_FLECK_UNDULATION_SPEED * _DeltaTime);
            }
            // Clump pull, OUTSIDE the flow gate so it keeps acting while a fleck slows and its
            // ripple dies: pull UP the shared foam noise gradient toward its maxima, gated by
            // MID-LIFE x SLOWNESS - strongest exactly AFTER the crest has passed - with a small
            // always-on floor. Mirrors KWS's clumpingLifetime * clumpingByVelocity attraction.
            float clumpNormalizedLife = saturate(particle.age / max(particle.life, 1e-4));
            float clumpLifeGate = saturate(sin(clumpNormalizedLife * (PARTICLE_TWO_PI * 0.5)) * 4.0);
            float clumpSlowGate = 1.0 - saturate(length(particle.velocity.xz)
                                                 / CREST_FLECK_CLUMP_SLOW_SPEED);
            float clumpFactor = saturate(clumpLifeGate * clumpSlowGate + CREST_FLECK_CLUMP_FLOOR);
            float2 clumpGrad = FoamNoiseGrad(particle.worldPos.xz * FOAM_NOISE_SCALE
                                             + _FoamTime * FOAM_NOISE_DRIFT);
            particle.worldPos.xz += clumpGrad
                                  * (CREST_FLECK_CLUMP_SPEED * clumpFactor * _DeltaTime);
        }
        else
        {
            // Curl + clumping (KWS): a divergence-free swirl (gradient rotated 90 degrees) keeps
            // floating foam alive, and a gentle pull UP the noise gradient gathers it into
            // streaks/patches instead of a uniform sprinkle. The field drifts slowly so clumps
            // form, wander and dissolve.
            float2 noiseGrad = FoamNoiseGrad(particle.worldPos.xz * FOAM_NOISE_SCALE
                                             + _FoamTime * FOAM_NOISE_DRIFT);
            driven += float3(noiseGrad.y, 0.0, -noiseGrad.x) * FOAM_CURL_SPEED
                    + float3(noiseGrad.x, 0.0, noiseGrad.y) * FOAM_CLUMP_SPEED;
            particle.velocity = lerp(particle.velocity, driven, saturate(_Drag * _DeltaTime));
            particle.velocity.y = 0.0;
            particle.worldPos += particle.velocity * _DeltaTime;
        }
        particle.worldPos.y = 0.0;
    }

    Particles[slot] = particle;
}

// One thread per density texel: reset for this frame's splats.
[numthreads(UPDATE_THREAD_GROUP_SIZE, 1, 1)]
void ClearDensity(uint3 id : SV_DispatchThreadID)
{
    // One dispatch clears every tier: the base tier is the largest, so its thread count
    // covers the halved tiers with per-tier bounds checks.
    uint texelCount = _DensitySize.x * _DensitySize.y;
    if (id.x < texelCount)
    {
        DensityBuffer[id.x] = 0u;
        DensityDepth[id.x] = DEPTH_CLEAR;
    }
    uint2 tier1Size = DensityTierSize(1u);
    if (id.x < tier1Size.x * tier1Size.y) DensityBufferTier1[id.x] = 0u;
    uint2 tier2Size = DensityTierSize(2u);
    if (id.x < tier2Size.x * tier2Size.y) DensityBufferTier2[id.x] = 0u;
}

// One thread per pool slot (KWS RenderParticlesToScreenSpaceBuffer): every live FLOATING
// particle splats its life-enveloped weight into the screen-space density buffer with
// InterlockedAdd, and its eye depth with InterlockedMin (occlusion + soft fade in the
// composite). Spray stays on the textured-quad draw. Thousands of particles become one
// cheap density field instead of overlapping transparent quads.
[numthreads(UPDATE_THREAD_GROUP_SIZE, 1, 1)]
void RasterizeDensity(uint3 id : SV_DispatchThreadID)
{
    uint slot = id.x;
    if (slot >= _Capacity) return;

    FoamParticle particle = Particles[slot];
    if (particle.life <= 0.0 || particle.age >= particle.life) return;
    if (particle.kind != KIND_SURFACE && particle.kind != KIND_RIPPLE_CREST) return;

    float2 simNorm = WorldToSimNorm(particle.worldPos);
    float3 world = particle.worldPos;
    world.y = SurfaceWorldY(world, simNorm);

    float2 uv; float eyeDepth;
    if (!ProjectToScreen(world, uv, eyeDepth)) return;
    if (any(uv < 0.0) || any(uv > 1.0)) return;

    float weight = FoamParticleEnvelope(particle.age, particle.life) * particle.strength;
    if (weight <= 0.0) return;

    uint fixedWeight = max(1u, (uint)(weight * _DensityWeightScale));
    uint depthMm = (uint)(eyeDepth * DEPTH_TO_MM);

    // Projected footprint in density texels (vertical focal term / eye depth), clamped so
    // the loop stays bounded; the composite's dilation closes pinholes beyond the clamp.
    float radiusPx = particle.size * _DensityProj11 * (float)_DensitySize.y * 0.5 / eyeDepth;

    if (particle.kind == KIND_RIPPLE_CREST)
    {
        // Select the KWS-style LOD tier from projected size, then write a compact tent into that
        // tier. The tier still owns the apparent scale; the footprint gives the clumping field
        // enough screen-space support for neighbouring flecks to form a continuous veil.
        float diameterPx = radiusPx * 2.0;
        float tierJitter = 1.0 + (particle.seed - 0.5) * 2.0 * DENSITY_TIER_JITTER_FRACTION;
        uint tier;
        if (diameterPx <= DENSITY_TIER0_MAX_DIAMETER_TEXELS * tierJitter) tier = 0u;
        else if (diameterPx <= DENSITY_TIER1_MAX_DIAMETER_TEXELS * tierJitter) tier = 1u;
        else tier = 2u;

        uint2 tierSize = DensityTierSize(tier);
        int2 tierCentre = min((int2)(uv * (float2)tierSize), (int2)tierSize - 1);
        for (int y = -DENSITY_FLECK_FOOTPRINT_RADIUS; y <= DENSITY_FLECK_FOOTPRINT_RADIUS; y++)
            for (int x = -DENSITY_FLECK_FOOTPRINT_RADIUS; x <= DENSITY_FLECK_FOOTPRINT_RADIUS; x++)
            {
                int2 tierPixelSigned = tierCentre + int2(x, y);
                if (any(tierPixelSigned < 0) || any(tierPixelSigned >= (int2)tierSize)) continue;

                float axisWeightX = x == 0 ? 1.0 : DENSITY_FLECK_FOOTPRINT_AXIS_FALLOFF;
                float axisWeightY = y == 0 ? 1.0 : DENSITY_FLECK_FOOTPRINT_AXIS_FALLOFF;
                uint footprintWeight = (uint)(fixedWeight * axisWeightX * axisWeightY);
                if (footprintWeight == 0u) continue;

                uint2 tierPixel = (uint2)tierPixelSigned;
                uint tierIndex = tierPixel.y * tierSize.x + tierPixel.x;
                AddFleckDensity(tier, tierIndex, footprintWeight);
                // Every expanded density texel receives matching base-resolution depth, so the
                // composite cannot erase the new veil edge as an unoccluded empty sample.
                WriteFleckDepth(tierPixel, tier, depthMm);
            }
        return;
    }

    // Surface deposits preserve the authored foam atlas silhouette. The density field stores the
    // sampled texture coverage, not a procedural disc, so an isolated landing reads as foam art
    // rather than a round point. Overlapping textured stamps still accumulate into a dense patch.
    float scaledSurfaceRadiusPx = radiusPx * _DensitySurfaceSizeScale;
    int radius = clamp((int)ceil(scaledSurfaceRadiusPx), SURFACE_ATLAS_RADIUS_MIN,
                       SURFACE_ATLAS_RADIUS_MAX);
    int stampDiameter = radius * 2 + 1;
    uint stampWidth, stampHeight;
    _DensityStampTex.GetDimensions(stampWidth, stampHeight);
    uint columns = max((uint)_DensityStampGrid.x, 1u);
    uint rows = max((uint)_DensityStampGrid.y, 1u);
    uint cellCount = columns * rows;
    uint cell = min((uint)(particle.seed * cellCount), cellCount - 1u);
    uint cellRow = min((uint)floor((float)cell * rcp((float)columns)), rows - 1u);
    uint cellColumn = cell - cellRow * columns;
    uint2 cellOrigin = uint2(cellColumn, cellRow);

    int2 centre = (int2)(uv * (float2)_DensitySize);
    for (int dy = -radius; dy <= radius; dy++)
        for (int dx = -radius; dx <= radius; dx++)
        {
            int2 p = centre + int2(dx, dy);
            if (any(p < 0) || p.x >= (int)_DensitySize.x || p.y >= (int)_DensitySize.y) continue;

            float2 localUv = (float2(dx, dy) + radius + 0.5) / stampDiameter;
            float2 atlasUv = (float2(cellOrigin) + localUv) / float2(columns, rows);
            uint2 stampPixel = min((uint2)(atlasUv * float2(stampWidth, stampHeight)),
                                   uint2(stampWidth - 1u, stampHeight - 1u));
            float stampAlpha = saturate(_DensityStampTex.Load(int3(stampPixel, 0)).a);
            uint weightedDensity = (uint)(fixedWeight * stampAlpha);
            if (weightedDensity == 0u) continue;

            uint index = (uint)p.y * _DensitySize.x + (uint)p.x;
            InterlockedAdd(DensityBuffer[index], weightedDensity);
            InterlockedMin(DensityDepth[index], depthMm);
        }
}
