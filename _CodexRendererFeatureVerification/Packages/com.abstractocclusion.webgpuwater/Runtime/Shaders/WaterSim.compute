// WebGpuWater - GPU heightfield simulation (Unity 6 / URP port)
// Original: Evan Wallace, http://madebyevan.com/webgl-water/ (MIT)
//
// Texture channels (per texel): (height, velocity, normal.x, normal.z)
// Ping-pong between two RGBAFloat RenderTextures (Src -> Dst), swapped in C#.

#include "WaterFoamCommon.hlsl" // FoamDecayBlend: split decay shared with OceanFft.compute
#include "WaterSurfWaves.hlsl"  // surf breaker-front whitewash source (pure math; textures below)
#include "WaterSimLimits.hlsl"  // WATER_SIM_MAX_ABS_*: the containment bounds, shared with the
                                //                      surface headroom debug view
#include "WaterShoreMath.hlsl"  // sampler-free shore math: SHORE_BORDER_FEATHER, ShoreFieldUVFrom,
                                // ShoreFieldInfluence, ShoreDecodeToShore (this compute cannot
                                // include the sampler2D-bearing WaterShore.hlsl; textures below)

#pragma kernel Drop
#pragma kernel SphereInteract
#pragma kernel Update
#pragma kernel Normal
#pragma kernel Obstacle
#pragma kernel ObstacleSmooth
#pragma kernel Foam
#pragma kernel ReduceMean
#pragma kernel ReduceMeanFinal
#pragma kernel ReduceActivity
#pragma kernel ReduceActivityFinal
#pragma kernel Conserve
#pragma kernel Scroll
#pragma kernel ScrollFoam

// Compute thread-group size. MUST equal WaterSimulation.ThreadGroupSize on the C# side.
#define THREAD_GROUP_SIZE 8

// Threads in one reduction group (8x8 spatial pass and the 1D final pass alike).
#define REDUCE_GROUP_THREADS 64

static const float PI = 3.141592653589793;

// IEEE-754 exponent bits are all ones only for infinity and NaN. A bit test preserves the
// simulation's fail-safe reset without D3D's misleading isfinite() optimization warning.
static const uint FLOAT_EXPONENT_MASK = 0x7F800000u;

// The hard bounds on the simulated field (and why they exist) live in WaterSimLimits.hlsl,
// included above: the surface's headroom debug view tests against the same two numbers, and a
// second private copy would let the view draw the clamp somewhere it does not fire.

// Rest state written into cells newly exposed by a window scroll: flat surface
// (height 0, velocity 0) with an upward normal (normal.xz = 0, stored in .ba).
static const float4 REST_STATE = float4(0.0, 0.0, 0.0, 0.0);

// Cap the per-step foam backtrace so a steep ripple can't fling foam across the
// pool in a single step (keeps the semi-Lagrangian advection stable).
static const float FOAM_MAX_ADVECT_TEXELS = 4.0;

// Passive shallow-water horizontal momentum for crest-fleck transport. This deliberately does not
// feed back into the established height solver: it gives particles coherent live flow without
// changing the visible ripple, foam-mask, caustic, or surface simulation contracts.
static const float FLOW_GRAVITY_METERS_PER_SECOND_SQUARED = 9.81;
static const float FLOW_REFERENCE_STEP_SECONDS = 1.0 / 60.0;
static const float FLOW_DAMPING_PER_REFERENCE_STEP = 0.96;
static const float FLOW_VISCOSITY = 0.12;
static const float FLOW_MAX_SPEED_METERS_PER_SECOND = 3.0;
static const float FLOW_COURANT_FRACTION = 0.5;

// Shear foam: fraction of the speed response given to the spatial gradient of the
// sim velocity (wake edges / dipole rims whiten where moving water borders still).
static const float FOAM_SHEAR_FRACTION = 1.0;

// Temporal hysteresis of the generation knees (StepFoam). Authored values can sit right
// ON the knees (_FoamGenThreshold / _FoamMinWaveHeight), so a violent sea strobes
// generation on/off frame-to-frame and whole patches pop (foam / no-foam / foam).
// SENSE: how much existing foam counts as "this cell is foaming" (1 / foam units);
// KNEE_RELAX: how far both knees drop for a fully-foamed cell (fraction of the knee).
static const float FOAM_STICKY_SENSE = 4.0;
static const float FOAM_STICKY_KNEE_RELAX = 0.5;

// Foam level at which decay is fully the FRESH rate. Real foam collapses quickly
// while thick and bright, then the thin residual lace lingers much longer; a single
// exponential can't do both, so decay blends between two rates by foam amount.
// (Removed once, restored: the "residual everywhere" complaint traced to NOISE
// generation - fixed by _FoamMinWaveHeight - not to the residual decay itself.)
static const float FOAM_FRESH_THRESHOLD = 0.5;

// Separable 5x5 Gaussian (outer product, weights sum to 16x16 = 256). Used to soften
// the obstacle footprint so an object injects a smooth bump instead of a hard edge.
static const float OBSTACLE_BLUR_W[5] = { 1.0, 4.0, 6.0, 4.0, 1.0 };
static const float OBSTACLE_BLUR_SUM = 256.0;

// Soft dead-band on the blurred footprint delta, in submerged-thickness WORLD units
// (matches the obstacle map's R channel), set from C# (_ObstacleDeadband). Residual
// sub-threshold flicker - rasterization noise as an object drifts or slowly rotates -
// is swallowed instead of stamped into the pool as micro-ripples (which then shimmer
// through the caustics and god rays). Set too high it also swallows a slow float's
// genuine (sub-millimetre per-frame) footprint delta, making the wake invisible - hence
// it is a tunable, not a buried constant.

// Dst is a write-only storage texture; Src is sampled (read). Keeping the read
// path as a sampled Texture2D instead of a read-write RWTexture2D is required by
// the WebGPU backend, which only allows r32 formats as read-write storage.
Texture2D<float4>   Src;   // previous state (read via Load)
RWTexture2D<float4> Dst;   // write destination
Texture2D<float2>   FlowSrc; // local horizontal surface velocity, metres per second
RWTexture2D<float2> FlowDst;

// Exact mean-height reduction for Conserve. The old path (Blit + GenerateMips, read the
// 1x1 top mip) silently broke in WebGPU builds: float32 textures are NOT filterable there,
// so the emulated mip chain point-samples and the "mean" collapses to one arbitrary texel
// of the ripple field - Conserve then subtracted a wave crest/trough instead of the true
// mean, riding the whole plane up and popping it down. A groupshared tree reduction sums
// every texel exactly on every backend (and is cheaper than the fullscreen blit was).
RWStructuredBuffer<float> PartialSums; // one partial sum per 8x8 group (ReduceMean out)
RWStructuredBuffer<float> MeanResult;  // single float: the exact mean height
RWStructuredBuffer<float> ActivityPartialMax; // one normalized activity maximum per 8x8 group
RWStructuredBuffer<float> ActivityResult;     // single normalized maximum for ocean sleep

groupshared float gsSum[REDUCE_GROUP_THREADS];

float  _Size;     // texture resolution (set per quality tier from C#)
float2 _Delta;    // 1.0 / _Size
float2 _FlowGradientToWorld; // central height difference -> world slope, set per body
float2 _FlowTexelMeters; // physical cell size in the local horizontal frame, set per body
float  _MeanCorrectionMax; // Conserve: max |mean| subtracted per step (pool units); pure safety clamp
float4 _ActivityInverseThresholds; // height, vertical velocity, horizontal flow, foam
float _ActivityWetMarkInverseThreshold;

// Scroll (windowed large bodies): integer texel shift of the whole sim state so
// ripples stay world-anchored while the sim window follows the camera. C# passes
// the offset with the sign that keeps world features fixed (see WaterSimulation.Scroll).
int2 _ScrollOffset;

// ---- Queued injection -------------------------------------------------------------------------
// Drops and wake interactors used to cost ONE FULL-GRID PING-PONG EACH. A moving object emits up to
// WaterInteractable.MaxDropsPerFrame drops per frame, so stamping a boat's wake read and wrote the
// entire field four times over - several times the cost of the sim step it was decorating, and four
// serial pipeline barriers. Both stamps are purely ADDITIVE, so every one queued this frame can be
// applied inside a SINGLE pass: the maths per stamp is untouched, only the number of times the grid
// is walked. Sanitize / saturate stay INSIDE the loops so per-stamp clamping order is preserved.
//
// The loop bound is the COUNT uniform, not the buffer size, so there is no capacity constant to keep
// in sync on this side - C# owns the queue length (WaterSimulation.MaxQueuedInjections).
struct WaterDropInjection
{
    float2 center;   // sim space [-1, 1]
    float  radius;   // half-extent fraction
    float  strength;
};

struct WaterSphereInjection
{
    float2 center;   // sim space [-1, 1]
    float2 velXZ;    // horizontal motion this step, sim-normalised (front/back dipole axis)
    float  radius;   // half-extent fraction
    float  velY;     // vertical motion this step, pool-height units (bobbing term)
    float  weight;   // submersion x user weight (0 = no effect)
    float  strength; // master gain on the injected acceleration
    float  wakeFoamDose; // world-speed/time foam source, independent of pool-height scaling
    float  verticalForceCap; // cap on this stamp's plunge/heave push; 0 = off
};

StructuredBuffer<WaterDropInjection>   DropQueue;
StructuredBuffer<WaterSphereInjection> SphereQueue;
uint _DropQueueCount;
uint _SphereQueueCount;

// Per-axis squash of the drop stamp so a drop reads ROUND in WORLD on a rectangular pool. The
// sim grid is square over pool space, so without this a circular pool-space stamp is stretched
// to the extent ratio in world. Default (1,1) = square (unchanged). Set from C# per body.
float2 _DropAxisScale;

// SphereInteract (velocity-dipole interactor, ported from Crest's SphereWaterInteraction).
// A moving sphere accelerates the water's VELOCITY channel (not height) with a directional
// dipole: pushed AHEAD of travel, pulled BEHIND, plus a symmetric vertical term for bobbing.
// The wave solver then integrates that velocity into height, so a continuous path lays a
// Kelvin V-wake instead of the isotropic rings a height splat (Drop) produces. All coords are
// pool/sim-normalised: the centre matches the drop's [-1,1] convention, radius/velocity are in the
// same normalised space so the field stays round-in-world on rectangular pools via _SphereAxisScale.
// Per-interactor values live in SphereQueue above; only the shared squash is a uniform.
float2 _SphereAxisScale; // per-axis world-round squash (mirrors _DropAxisScale)

// Dipole tightness: the falloff peaks near ~0.7/a, so a ~ TIGHTNESS/radius places the deposited
// energy around the sphere rim. Vertical is slightly tighter than horizontal, mirroring Crest's
// 1.67 vs 1.43 minimum-wavelength ratio.
static const float SPHERE_FALLOFF_VERT  = 1.6;
static const float SPHERE_FALLOFF_HORIZ = 1.4;
// Nested-sphere shaping (Crest values): the inner region (deeper than radius*OFFSET inside the
// surface) also drives horizontal force, weighted up by MULT, so the dipole wraps the hull
// instead of collapsing to a single ring.
static const float SPHERE_INNER_OFFSET = 0.109;
static const float SPHERE_INNER_MULT   = 1.55;
// Cull radius (in sphere radii): beyond this the sphere contributes nothing.
static const float SPHERE_CULL_RADII = 4.0;

// Band-limited interaction falloff (Ottosson): ~a*x near 0, decays like 1/x^5 far out. Odd in x,
// so it flips sign across the surface - the inside/outside sign change the dipole model relies on.
float InteractionFalloff(float a, float x)
{
    float ax = a * x;
    float ax2 = ax * ax;
    float ax4 = ax2 * ax2;
    return ax / (1.0 + ax2 * ax4);
}

// Update (wave equation tuning)
float  _WaveSpeed; // stiffness ~ propagation speed (stable for 0 < x <= 2.0)
float  _Damping;   // velocity attenuation per step (e.g. 0.995)
// Kinematic viscosity on the VELOCITY channel, per step. 0 = off (the field is byte-identical).
float  _RippleViscosity;
// Per-axis Laplacian weight so waves propagate at equal WORLD speed on a rectangular pool
// (weight ~ 1/extent^2 per axis, normalised so the max stays 0.25 = the stable square value).
// Default (0.25, 0.25) = the isotropic square case (unchanged). Set from C# per body.
float2 _WaveAxisWeight;

// Obstacle displacement: submerged-footprint maps from the previous and current
// frame (R channel = submerged amount per column), rendered top-down by C#.
// Generalises the old analytic Sphere kernel to arbitrary meshes.
Texture2D<float4> ObstaclePrev;
Texture2D<float4> ObstacleCurr;
float _ObstacleStrength;
float _ObstacleFlipY;   // 1 = flip V to match the sim's coordinate convention
float _ObstacleDeadband; // soft dead-band on the blurred delta (submerged-thickness world units)

// Static reflection (opt-in): submerged footprint of REFLECTOR-flagged objects only. A cell whose
// coverage exceeds _ObstacleSolidThreshold is "solid" - the object occupies it. In Update a water
// cell mirrors its OWN height across a solid neighbour (zero-gradient Neumann wall) so ripples bounce
// instead of transmitting; solid cells hold flat (with an optional resting dip). _ObstacleReflect 0 =
// disabled -> ObstacleSolid is never sampled, sim byte-identical. Shares _ObstacleFlipY's convention.
Texture2D<float4> ObstacleSolid;
float _ObstacleReflect;         // 1 = reflection on
float _ObstacleSolidThreshold;  // coverage above which a solid-mask cell reflects
float _ObstacleRestDip;         // resting depression at solid cells (pool units); 0 = flat

// Footprint temporal EMA (ObstacleSmooth kernel): curr = lerp(prev-smoothed, raw, blend). Low-passes
// the frame-to-frame footprint so a moving object injects a few long clean waves instead of a dense
// packet of tight rings. Done in compute because the equivalent fullscreen material pass did not run
// on this URP/WebGPU backend. Dst is RFloat (r32) - the only RW storage format WebGPU guarantees.
Texture2D<float4> ObstacleSmoothPrev;
Texture2D<float4> ObstacleSmoothRaw;
RWTexture2D<float> ObstacleSmoothDst;
float _ObstacleTemporalBlend;   // EMA weight of the fresh footprint: 1 = no smoothing, ->0 = heavier

// Foam buffer, TWO channels (RGFloat / rg32float - both core WebGPU storage formats):
//   R = foam amount per column. Advected/diffused, generated from surface turbulence, decayed.
//   G = the WET MARK: the highest surface height this column has reached lately, in the same POOL
//       height units as the state's .r, drying downward toward the still level (0).
// WHY G LIVES HERE and not in its own target: this buffer is already a per-column ping-pong that
// runs every frame, already carries a decaying quantity, and - crucially - is already SCROLLED with
// the camera window (ScrollFoam). A dedicated wetness target would have had to duplicate all three.
// The two channels are independent: nothing reads across them.
Texture2D<float2>    FoamSrc;
RWTexture2D<float2>  FoamDst;
// Survival factor of the wet mark per REFERENCE STEP (1/60 s), computed C#-side from a DRY TIME in
// seconds (WaterVolume.Solver). Same shape as the foam's own decay - pow(survival, dtSteps) - so both
// are frame-rate independent in the same way.
//
// WHY A SURVIVAL FACTOR AND NOT THE LINEAR DROP THIS REPLACED: a constant drop is the honest physics
// of a receding film, but it makes the DURATION depend on how high the water reached - a 2 cm ripple
// dried in an eighth of a second at the same setting that left a 20 cm splash lingering. "How long
// does ground stay wet" is the question being authored, so the knob has to be a time, and an
// exponential is what makes that time height-independent.
// Wet-mark survival for THIS step - i.e. pow(survivalPerReferenceStep, _FoamDtSteps) already folded
// on the CPU (WaterSimulation.StepFoam). Both operands were uniforms, so the pow used to run once per
// texel to produce a single constant.
float _WetDryDecay;
// 1 while the foam LOOK is enabled, 0 when this kernel is running only to keep the wet mark alive.
// One multiply at the single write site is the whole gate: it is impossible to miss a foam source
// this way, whereas zeroing each of gen / deposit / shore-injection / wake separately is not.
float _FoamWriteMask;
float _FoamGenRate;       // how fast turbulence creates foam
float _FoamGenThreshold;  // activity level below which NO foam forms (small waves don't break)
float _FoamMinWaveHeight; // POOL-unit wave height below which NO foam forms (kills ripple noise)
float _FoamDecayFresh;    // survival PER REFERENCE STEP (1/60 s) of thick, fresh foam (e.g. 0.95)
float _FoamDecayResidual; // survival per reference step of thin residual lace (e.g. 0.995)
float _FoamDtSteps;       // elapsed time in reference steps; gen and decay scale by this so foam is frame-rate independent
float _FoamDecayRate;     // user time-scale on decay only (1 = authored speed, 2 = twice as fast)
float _FoamSpread;        // 0..1 diffusion toward neighbour average
float _FoamFromSpeed;  // foam from |velocity|
float _FoamFromCurv;   // foam from negative curvature (wave crests/chop)
float _FoamAdvect;     // texels foam is carried along the surface flow per step
float _FoamDeposit;    // 0..1 instant DEPOSIT floor: turbulence lays lasting foam, not just a rate trickle
// Headroom - "yield to existing foam". 0 = generation ignores what is already on the column
// (legacy). 1 = the additive rate is scaled by the FREE surface, so the ripple engine stands down
// wherever something else already whitened this water. See the use site in Foam() for why this is
// the one gate the activity knobs cannot express.
float _FoamHeadroom;

// Shallow-water breaking boost (foam pass move #1). Where a baked bed makes the water column
// shallow, waves shoal and break more readily, so surface turbulence aerates white far sooner
// than it does in deep water (the selective, over-the-shelf whitecapping KWS gates on Froude
// number). This BOOSTS generation in shallow, fast-moving water; it never suppresses deep-water
// foam, so a bottomless body (or _FoamBreakStrength 0) is byte-identical. Depth is read from the
// bed map already bound for the Update pass (BedColumnDepth); inert unless _UseBedDepth is set.
float _FoamBreakStrength; // 0 = off (identity), 1 = full shallow-breaking boost
float _FoamBreakRange;    // pool-unit column depth over which "shallow" ramps to "deep" (<=0 = off)
// Froude gate constants: only the RATIO speed/sqrt(g*depth) matters here, so g just sets the scale
// the LO/HI knees sit on. LO/HI mirror KWS's supercritical-flow window. MAX_BOOST caps how much
// shallow breaking can multiply local generation.
static const float FOAM_BREAK_GRAVITY   = 9.81;
static const float FOAM_BREAK_FROUDE_LO = 0.15;
static const float FOAM_BREAK_FROUDE_HI = 0.65;
static const float FOAM_BREAK_MIN_DEPTH = 1e-3; // guards the sqrt on a near-dry column
static const float FOAM_BREAK_MAX_BOOST = 2.0;  // shallow breaking can up to triple local gen (1 + 2)

// Crest-selective generation (foam move #2). The amplitude gate blends from ABSOLUTE wave height
// (rise above rest) toward CREST height (rise above the local neighbourhood mean = max(0,-lap)) by
// _FoamCrestBias. At bias 1 foam forms on wave crests and skips the equally-tall troughs a fast
// wake or chop leaves behind - the KWS "height above local average" whitecap rule. 0 = old behaviour.
float _FoamCrestBias;

// Wake foam (foam move #3). A moving hull churns air into the water, so the SphereInteract kernel
// stamps foam directly at the interactor, scaled by its speed, and StepFoam then advects + decays it
// into the trailing wake (the emergent shear foam alone reads thin - the heightfield carries no true
// horizontal current). _WakeFoamStrength 0 = off: foam is copied through unchanged, byte-identical.
float _WakeFoamStrength;    // master gain on the wake stamp
float _WakeFoamRadiusScale; // stamp radius as a multiple of the sphere radius

// Wake start-force cap: the largest per-step velocity a single interactor stamp may inject. A FRESH
// wake over still water dumps a concentrated push toward the velocity ceiling in a few texels, which
// the solver integrates into a too-tall crest before spreading it; capping the push clips that initial
// overshoot while the developed wake (many smaller pushes below the cap) keeps its shape. 0 = off.
float _WakeStartForceCap;

// Bed depth (Phase 1 shoreline): pool-space terrain bed height (R = bed pool-Y), baked by
// WaterVolume in the SAME pool frame as the sim, so a sim cell's UV maps straight to it. Used to
// hold dry land flat (ripples reflect off the waterline) and drain the open-shore boundary.
// Inactive (_UseBedDepth = 0) on bodies without a bed, so those behave exactly as a bottomless pool.
Texture2D<float> _BedTex;
SamplerState sampler_BedTex;
float _UseBedDepth;        // 1 = bed active

// Surf breaker-front foam (coastline Layer D): the same analytic front field the surface renders
// (WaterSurfWaves.hlsl), injected as GENERATION like the hero wave so it advects, diffuses and
// decays with everything else - the near-field, organic counterpart of the surface's analytic
// whitewash. The Layer A shore fields are bound EXPLICITLY here (Texture2D form - the sampler2D
// header would clash in compute), with the same uv frame the shaders use. Pushed by
// WaterVolume.PushShoreFoam just before StepFoam; inactive = the whole block is skipped.
float  _ShoreFoamInject;        // 1 = inject surf foam this step (an injection gain is non-zero).
                                // The companion _ShoreFoamActive ("the front field is live") is
                                // read by the PARTICLE compute only, so it is not declared here.
float  _ShoreFoamGain;          // master gain on breaker + whitewash injection
float  _ShoreWaterlineFoamGain; // standing waterline lace gain
float  _ShoreSwashDepositGain;  // FOAM-5: persistent swash-deposit injection gain (0 = off)
// FOAM-5 swash-deposit shaping: metres of beach height the receding film edge lays foam over,
// and how far past the uprush apex the backwash starts depositing.
#define SHORE_SWASH_DEPOSIT_BAND  0.2
#define SHORE_SWASH_DEPOSIT_ONSET 0.08
float  _ShoreFoamTime;          // THE MASTER SURF BEAT (matches the surface _SurfBeatTime)
float4 _ShoreSimUvToWorldOrigin; // xy = world xz of sim uv (0, 0) - the sim's own affine
float4 _ShoreSimUvToWorldAxes;   // xy = world xz span across uv.x, zw = span across uv.y
float4 _ShoreFieldCenterSim;    // xy = world XZ centre of the Layer A field
float4 _ShoreFieldSizeSim;      // xy = world XZ half-extent of the Layer A field
Texture2D<float>  _ShoreDepthTexSim;  SamplerState sampler_ShoreDepthTexSim; // column depth (m), half
Texture2D<float4> _ShoreSDFTexSim;    SamplerState sampler_ShoreSDFTexSim;   // dir(0..1), dist, slope tan(beta)
// FOAM-1: the crest-foam pop LUT - the SAME bake the surface samples as _SurfCrestFoamLut, bound
// by ShoreFoamState.BindTo, so injected crest foam pops on exactly the artist's timing. Inactive =
// the legacy fixed-weight breaker injection below.
Texture2D<float4> _ShoreCrestFoamLutSim; SamplerState sampler_ShoreCrestFoamLutSim;
float _ShoreCrestFoamLutActive; // 1 = pop curve drives the crest injection
float _ShoreCrestFoamGain;      // matches the surface's _SurfCrestFoamGain
// Legacy weight of the cresting-lip signal in the injection (the pre-pop-curve behaviour).
static const float SURF_SIM_BREAKER_WEIGHT = 0.6;
// "Deep" column depth used when no bed is active, so shoal/shore terms are no-ops there.
static const float BED_DEEP_DEPTH = 1000.0;

// DRAIN_BAND is the outer UV band over which the open-shore boundary drain absorbs outgoing ripples
// (so they don't reflect or pile at the domain edge). Bed-active bodies only.
static const float DRAIN_BAND = 0.08;

// Still-water column depth (pool units) at a sim cell: the rest surface sits at pool y = 0 and the
// bed below it, so depth = -bedPoolY. Read through the texture's own BILINEAR filter, not point:
// the surface shares this texture and needs filtering for depth-clarity (see WaterBedBaker).
float BedColumnDepth(float2 uv)
{
    if (_UseBedDepth < 0.5) return BED_DEEP_DEPTH;
    float bedPoolY = _BedTex.SampleLevel(sampler_BedTex, uv, 0);
    return -bedPoolY;
}

int Clamp1(int v)            { return clamp(v, 0, (int)_Size - 1); }
int2 ClampC(int2 p)         { return int2(Clamp1(p.x), Clamp1(p.y)); }

// Clamped texel fetch from the sampled source texture.
float4 Read(int2 p)         { return Src.Load(int3(ClampC(p), 0)); }
float2 ReadFlow(int2 p)     { return FlowSrc.Load(int3(ClampC(p), 0)); }

float2 SampleFlow(float2 texelPosition)
{
    float2 clampedPosition = clamp(texelPosition, 0.0, _Size - 1.0);
    int2 baseTexel = (int2)floor(clampedPosition);
    float2 fraction = clampedPosition - baseTexel;
    float2 c00 = ReadFlow(baseTexel);
    float2 c10 = ReadFlow(baseTexel + int2(1, 0));
    float2 c01 = ReadFlow(baseTexel + int2(0, 1));
    float2 c11 = ReadFlow(baseTexel + int2(1, 1));
    return lerp(lerp(c00, c10, fraction.x), lerp(c01, c11, fraction.x), fraction.y);
}

float2 SanitizeFlow(float2 flow)
{
    if (any((asuint(flow) & FLOAT_EXPONENT_MASK) == FLOAT_EXPONENT_MASK)) return 0.0;
    return clamp(flow, -FLOW_MAX_SPEED_METERS_PER_SECOND, FLOW_MAX_SPEED_METERS_PER_SECOND);
}

// Reset a diverged (non-finite) texel and clamp the field to its stable range, so a
// single runaway value can't propagate through the mean/normal passes.
float4 Sanitize(float4 info)
{
    bool invalidHeight = (asuint(info.r) & FLOAT_EXPONENT_MASK) == FLOAT_EXPONENT_MASK;
    bool invalidVelocity = (asuint(info.g) & FLOAT_EXPONENT_MASK) == FLOAT_EXPONENT_MASK;
    if (invalidHeight || invalidVelocity) { info.r = 0.0; info.g = 0.0; }
    info.r = clamp(info.r, -WATER_SIM_MAX_ABS_HEIGHT, WATER_SIM_MAX_ABS_HEIGHT);
    info.g = clamp(info.g, -WATER_SIM_MAX_ABS_VELOCITY, WATER_SIM_MAX_ABS_VELOCITY);
    return info;
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Drop(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float2 coord = (p + 0.5) * _Delta;
    float4 info = Read(p);

    for (uint i = 0; i < _DropQueueCount; i++)
    {
        WaterDropInjection q = DropQueue[i];
        // Squash the pool-space delta per axis so the falloff is a circle in WORLD, not in the
        // (square) sim grid - otherwise a drop on a rectangular pool stamps an ellipse.
        float2 d = (q.center * 0.5 + 0.5 - coord) * _DropAxisScale;
        float drop = max(0.0, 1.0 - length(d) / q.radius);
        drop = 0.5 - cos(drop * PI) * 0.5;
        info.r += drop * q.strength;
        // Clamped PER STAMP, exactly as one dispatch per drop used to be, so a stack of drops
        // saturates the same way it always did rather than summing past the ceiling first.
        info = Sanitize(info);
    }

    Dst[p] = Sanitize(info);
}

// Moving-sphere interactor: accelerate the water's velocity channel with a directional dipole so a
// travelling object lays a wake. Ported from Crest's SphereWaterInteraction.compute, adapted to this
// port's single-grid (height, velocity, normal.xz) field: Crest writes acceleration into its velocity
// slice, we write into info.g the same way, and the Update kernel integrates it into height next step.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void SphereInteract(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 info = Read(p);
    float2 coord = (p + 0.5) * _Delta;
    // Read the foam ONCE and carry it: this kernel ping-pongs the whole field, so every texel writes
    // its (possibly unchanged) state to Dst and FoamDst whether any interactor reached it or not.
    float2 foam = FoamSrc.Load(int3(p, 0));

    for (uint i = 0; i < _SphereQueueCount; i++)
    {
        WaterSphereInjection q = SphereQueue[i];
        // Offset from the sphere centre in the SAME normalised [0,1] space as Drop, squashed per axis
        // so the interaction is round in WORLD on a rectangular pool.
        float2 d = (coord - (q.center * 0.5 + 0.5)) * _SphereAxisScale;
        float dist = length(d);
        if (dist > q.radius * SPHERE_CULL_RADII) continue;   // this texel is outside THIS interactor

        float sdf = dist - q.radius;                      // signed distance to the sphere in the plane
        float2 nrm = dist > 1e-5 ? d / dist : float2(0.0, 0.0); // outward normal

        float a = 1.0 / max(q.radius, 1e-4);              // scale falloff to the sphere size

        // Vertical (bobbing) term: symmetric about the sphere, driven by vertical motion. Signed sdf
        // keeps Crest's inside/outside sign flip.
        float verticalForce = -q.velY * InteractionFalloff(SPHERE_FALLOFF_VERT * a, sdf);

        // Horizontal (wake) term: +push ahead of motion, -pull behind -> a dipole that, smeared along
        // a path, becomes the V-wake. Gated to the outside plus the inner nested sphere (Crest's model).
        float horizontalForce = 0.0;
        if (sdf > 0.0 || sdf < -q.radius * SPHERE_INNER_OFFSET)
        {
            float forceSign = sign(sdf);
            horizontalForce = forceSign * dot(nrm, q.velXZ)
                                        * InteractionFalloff(SPHERE_FALLOFF_HORIZ * a, abs(sdf));
            if (sdf < 0.0) horizontalForce *= SPHERE_INNER_MULT;
        }

        float verticalPush = q.weight * verticalForce * q.strength;
        if (q.verticalForceCap > 0.0)
            verticalPush = clamp(verticalPush, -q.verticalForceCap, q.verticalForceCap);
        float horizontalPush = q.weight * horizontalForce * q.strength;
        float wakePush = verticalPush + horizontalPush;
        // Cap the per-step push so a fresh stamp can't spike a too-tall crest (see _WakeStartForceCap).
        if (_WakeStartForceCap > 0.0)
            wakePush = clamp(wakePush, -_WakeStartForceCap, _WakeStartForceCap);
        info.g += wakePush;
        info = Sanitize(info);   // per-stamp, as one dispatch per interactor used to be

        // Wake foam uses its own world-speed/time dose. velXZ is intentionally NOT reused: it is
        // normalised by the body's vertical extent for the wave-force integrator, which made foam
        // coverage change when only the water depth changed.
        float wakeDisc  = saturate(1.0 - dist / max(q.radius * _WakeFoamRadiusScale, 1e-4));
        float wakeDose = q.weight * _WakeFoamStrength * q.wakeFoamDose * wakeDisc;
        float wakeStamp = 1.0 - exp(-wakeDose);
        // R only: the wake deposits FOAM. The wet mark is owned solely by the Foam kernel, so an
        // interactor pass can never rewrite the waterline history behind its back.
        foam.r = 1.0 - (1.0 - foam.r) * (1.0 - wakeStamp);
    }

    Dst[p] = Sanitize(info);
    FoamDst[p] = foam;
}

// Solid-mask coverage at sim texel p, matching the obstacle map's flip convention and clamped so an
// edge neighbour never reads out of bounds.
float ObstacleSolidCover(int2 p)
{
    int hi = (int)_Size - 1;
    int2 q = p;
    if (_ObstacleFlipY > 0.5) q.y = hi - p.y;
    q = clamp(q, int2(0, 0), int2(hi, hi));
    return ObstacleSolid.Load(int3(q, 0)).r;
}

// True when cell p is occupied by a reflector. Early-outs when reflection is off so ObstacleSolid is
// never sampled (the sim then behaves exactly as before this feature).
bool ObstacleSolidAt(int2 p)
{
    if (_ObstacleReflect <= 0.5) return false;
    return ObstacleSolidCover(p) > _ObstacleSolidThreshold;
}

// Neighbour (height, velocity) for the Laplacian and the viscosity: mirror the CENTRE across a solid
// neighbour (zero-gradient Neumann wall) so ripples reflect; otherwise read the neighbour normally.
// Both channels come from ONE fetch, so the viscosity term below is free in bandwidth - the update
// was already loading these four texels and discarding everything but .r.
float2 ReflectiveNeighbour(int2 neighbour, float2 centreState)
{
    if (ObstacleSolidAt(neighbour)) return centreState;
    return Read(neighbour).rg;
}

float2 ReflectiveFlowNeighbour(int2 neighbour, float2 centreFlow)
{
    if (ObstacleSolidAt(neighbour)) return centreFlow;
    return ReadFlow(neighbour);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Update(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 info = Read(p);

    // Shoreline (bed depth): dry land holds flat so ripples REFLECT off the waterline instead of
    // climbing onto exposed terrain. Keep the normal channels; the Normal pass rederives them.
    float depth = BedColumnDepth(((float2)p + 0.5) * _Delta);
    if (depth <= 0.0)
    {
        Dst[p] = Sanitize(float4(0.0, 0.0, info.b, info.a));
        FlowDst[p] = 0.0;
        return;
    }

    // Static reflection: a cell the object occupies holds flat (optionally a small resting dip).
    // Neighbouring water mirrors off it rather than reading it (see ReflectiveNeighbour), so this held
    // value never drains their ripples - it only defines the object's own footprint on the surface.
    if (ObstacleSolidAt(p))
    {
        Dst[p] = Sanitize(float4(-_ObstacleRestDip, 0.0, info.b, info.a));
        FlowDst[p] = 0.0;
        return;
    }

    // Per-axis weighted Laplacian: the x- and z-neighbour curvatures are weighted separately
    // (_WaveAxisWeight) so waves travel at equal WORLD speed on a rectangular pool. With the
    // default (0.25, 0.25) this is exactly the old isotropic form: 0.25*(hL+hR+hD+hU) - h.
    // Neighbours read through ReflectiveNeighbour so a solid cell reflects instead of transmitting.
    float2 centre = info.rg;
    float2 nL = ReflectiveNeighbour(p + int2(-1, 0), centre);
    float2 nR = ReflectiveNeighbour(p + int2( 1, 0), centre);
    float2 nD = ReflectiveNeighbour(p + int2( 0,-1), centre);
    float2 nU = ReflectiveNeighbour(p + int2( 0, 1), centre);
    float force = _WaveAxisWeight.x * (nL.x + nR.x - 2.0 * info.r)
                + _WaveAxisWeight.y * (nD.x + nU.x - 2.0 * info.r);

    // move velocity by the restoring force, attenuate, integrate height
    info.g += force * _WaveSpeed;
    info.g *= _Damping;

    // VISCOSITY: pull the velocity toward its neighbourhood mean. The correction is proportional to
    // the LAPLACIAN of the velocity field, so it is ~0 on a long smooth swell and strongest on the
    // texel-to-texel checkerboard the explicit integrator's dispersive tail leaves behind - which is
    // the part the eye reads as noise rather than as water. _Damping cannot do this job: a flat
    // per-step multiplier takes the swell down at exactly the rate it takes the chop down.
    // Per STEP, like _Damping, and deliberately NOT re-based by the density ratio: this targets the
    // GRID frequency, which is a property of the lattice, not of world metres.
    if (_RippleViscosity > 0.0)
    {
        float neighbourVelocity = (nL.y + nR.y + nD.y + nU.y) * 0.25;
        info.g = lerp(info.g, neighbourVelocity, _RippleViscosity);
    }

    info.r += info.g;

    // Open-shore boundary drain: absorb ripples over the outer band so they don't reflect off the
    // domain edge or pile up (this replaces volume-conserve, which biases against a dry shore).
    // Displacement only (rest = 0), so the water level is untouched. No-op away from the edge.
    if (_UseBedDepth > 0.5)
    {
        float2 uvE = ((float2)p + 0.5) * _Delta;
        float edge = min(min(uvE.x, 1.0 - uvE.x), min(uvE.y, 1.0 - uvE.y));
        info.r *= smoothstep(0.0, DRAIN_BAND, edge);
    }

    Dst[p] = Sanitize(info);

    // Integrate pressure-driven horizontal velocity from the visible water-surface slope. This is
    // the linear shallow-water momentum term du/dt = -g grad(height), evaluated on the same lattice
    // as the wave solver. Damping and viscosity contain the unresolved grid-frequency mode without
    // mutating the heightfield that drives every existing consumer.
    float2 heightGradient = float2(nR.x - nL.x, nU.x - nD.x) * _FlowGradientToWorld;
    float2 previousFlow = ReadFlow(p);
    float2 backtraceTexels = previousFlow * FLOW_REFERENCE_STEP_SECONDS / _FlowTexelMeters;
    float2 flow = SampleFlow((float2)p - backtraceTexels);
    float2 flowL = ReflectiveFlowNeighbour(p + int2(-1, 0), flow);
    float2 flowR = ReflectiveFlowNeighbour(p + int2( 1, 0), flow);
    float2 flowD = ReflectiveFlowNeighbour(p + int2(0, -1), flow);
    float2 flowU = ReflectiveFlowNeighbour(p + int2(0,  1), flow);
    float2 neighbourFlow = (flowL + flowR + flowD + flowU) * 0.25;
    float2 pressureAcceleration = -FLOW_GRAVITY_METERS_PER_SECOND_SQUARED * heightGradient;
    flow += pressureAcceleration * FLOW_REFERENCE_STEP_SECONDS;
    flow *= FLOW_DAMPING_PER_REFERENCE_STEP;
    flow = lerp(flow, neighbourFlow, FLOW_VISCOSITY);
    float courantSpeedLimit = min(_FlowTexelMeters.x, _FlowTexelMeters.y)
                            * FLOW_COURANT_FRACTION / FLOW_REFERENCE_STEP_SECONDS;
    flow = clamp(flow, -courantSpeedLimit, courantSpeedLimit);
    FlowDst[p] = SanitizeFlow(flow);
}

[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Normal(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 info = Read(p);

    float rx = Read(p + int2(1, 0)).r;
    float ry = Read(p + int2(0, 1)).r;

    float3 dx = float3(_Delta.x, rx - info.r, 0.0);
    float3 dy = float3(0.0, ry - info.r, _Delta.y);
    info.ba = normalize(cross(dy, dx)).xz;

    Dst[p] = info;
}

// Push the surface by how much the submerged footprint changed since last frame:
// water rushes back where an object left a column and is pushed down where it
// entered (and deeper as the object sinks). Mirrors the old sphere old/new trick.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Obstacle(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    int2 oc = p;
    if (_ObstacleFlipY > 0.5) oc.y = (int)_Size - 1 - p.y; // sim texel -> obstacle-map texel

    float4 info = Read(p);

    // Blur the displacement delta with a 5x5 Gaussian so an object's hard-edged
    // footprint pushes the surface with a smooth bump (like the mouse drop) instead
    // of stamping sharp, jittery ripples at the silhouette edge as it bobs/drifts.
    float delta = 0.0;
    [unroll]
    for (int j = -2; j <= 2; j++)
    {
        [unroll]
        for (int i = -2; i <= 2; i++)
        {
            int2 q = ClampC(oc + int2(i, j));
            float w = OBSTACLE_BLUR_W[i + 2] * OBSTACLE_BLUR_W[j + 2];
            delta += (ObstaclePrev.Load(int3(q, 0)).r - ObstacleCurr.Load(int3(q, 0)).r) * w;
        }
    }
    // Soft knee: shift the delta toward zero by the dead-band instead of hard-gating,
    // so the response stays continuous (no pop when a real motion crosses the threshold).
    float blurred = delta / OBSTACLE_BLUR_SUM;
    blurred = sign(blurred) * max(0.0, abs(blurred) - _ObstacleDeadband);
    info.r += blurred * _ObstacleStrength;

    Dst[p] = info;
}

// Footprint temporal EMA: curr = lerp(prev-smoothed, raw, blend). Low-passes the footprint over time so
// continuous bobbing/rotation noise becomes a few long clean waves rather than a dense packet of tight
// rings. The wave equation is linear, so filtering the forcing's frequency content leaves the total
// displaced volume intact. Runs in compute because the fullscreen material equivalent failed on WebGPU.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ObstacleSmooth(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float prev = ObstacleSmoothPrev.Load(int3(p, 0)).r;
    float raw  = ObstacleSmoothRaw.Load(int3(p, 0)).r;
    ObstacleSmoothDst[p] = lerp(prev, raw, saturate(_ObstacleTemporalBlend));
}

// Advected foam: carried along the local surface flow (so it streaks with the
// waves and slides off crests instead of spreading evenly), softened by a little
// isotropic diffusion, fed where the surface is agitated, then decayed. Reads the
// height/normal state from Src and ping-pongs the foam buffer.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Foam(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 info = Read(p); // height/velocity/normal at this column

    // Water slides downhill and normal.xz = -gradient(height), so the horizontal
    // normal IS the flow direction. Backtrace one flow-step and sample the foam
    // there (semi-Lagrangian advection).
    float2 flow = clamp(info.ba * _FoamAdvect, -FOAM_MAX_ADVECT_TEXELS, FOAM_MAX_ADVECT_TEXELS);
    float2 srcF = float2(p) - flow;
    int2   s0   = (int2)floor(srcF);
    float2 t    = srcF - float2(s0);

    // Manual bilinear: WebGPU r32 storage textures aren't filterable, so we lerp
    // four Load() fetches instead of sampling.
    float f00 = FoamSrc.Load(int3(ClampC(s0 + int2(0, 0)), 0)).r;
    float f10 = FoamSrc.Load(int3(ClampC(s0 + int2(1, 0)), 0)).r;
    float f01 = FoamSrc.Load(int3(ClampC(s0 + int2(0, 1)), 0)).r;
    float f11 = FoamSrc.Load(int3(ClampC(s0 + int2(1, 1)), 0)).r;
    float advected = lerp(lerp(f00, f10, t.x), lerp(f01, f11, t.x), t.y);

    // small isotropic diffusion keeps foam edges from getting too stringy
    float fL = FoamSrc.Load(int3(ClampC(p + int2(-1, 0)), 0)).r;
    float fR = FoamSrc.Load(int3(ClampC(p + int2( 1, 0)), 0)).r;
    float fD = FoamSrc.Load(int3(ClampC(p + int2( 0,-1)), 0)).r;
    float fU = FoamSrc.Load(int3(ClampC(p + int2( 0, 1)), 0)).r;
    float foam = lerp(advected, (fL + fR + fD + fU) * 0.25, _FoamSpread);

    // generation from turbulence: speed + negative curvature (crests / chop) + shear.
    // Kept LINEAR on purpose: a hermite knee here amplifies every response above
    // 0.5 and floods the pool with foam. Edge softening is a render-side concern
    // (_FoamFeather in WaterSurface.shader), not a sim-side one.
    // Narrow (+/-1) taps feed the breaking-foam divergence below; the +/-2 taps build
    // the WAVELENGTH-FILTERED measurements the generation now runs on.
    float4 nL = Read(p + int2(-1, 0));
    float4 nR = Read(p + int2( 1, 0));
    float4 nD = Read(p + int2( 0,-1));
    float4 nU = Read(p + int2( 0, 1));
    float4 nL2 = Read(p + int2(-2, 0));
    float4 nR2 = Read(p + int2( 2, 0));
    float4 nD2 = Read(p + int2( 0,-2));
    float4 nU2 = Read(p + int2( 0, 2));

    // COHERENT speed: sign-preserving neighbourhood average. A real wavefront moves its
    // whole neighbourhood together and survives the average; the short dispersive chop a
    // ring leaves behind has the SAME height but alternates sign texel-to-texel, so it
    // cancels itself out here and generates nothing. This - not amplitude - is what
    // separates a ripple wave from ripple noise.
    float speed = abs((info.g + nL.g + nR.g + nD.g + nU.g
                       + nL2.g + nR2.g + nD2.g + nU2.g) / 9.0);
    // WIDE-stencil curvature: crests measured at double scale. Grid-frequency chop (whose
    // narrow 1-texel laplacian is HUGE - curvature ~ amp/lambda^2 rewards exactly the
    // noise) reads as flat at this scale, while real waves keep their crest signal.
    float lap = (nL2.r + nR2.r + nD2.r + nU2.r) * 0.25 - info.r;
    // Shear from the wide taps too (gradient of the coherent motion, span = 4 texels).
    float shear = length(float2(nR2.g - nL2.g, nU2.g - nD2.g)) * 0.25;

    // Breaking threshold (KWS/Crest both gate generation): real foam forms only where waves
    // BREAK, so activity below the threshold produces exactly ZERO - small waves pass clean.
    // The subtraction keeps the response linear above the knee (a hermite here floods the pool).
    float activity = (speed + shear * FOAM_SHEAR_FRACTION) * _FoamFromSpeed
                   + max(0.0, -lap) * _FoamFromCurv;
    // AMPLITUDE gate on top: waves shorter than the authored world height never foam. Crest-selective
    // generation (move #2): blend the gate signal from absolute height toward CREST height (rise above
    // the local mean = max(0,-lap), 0 in troughs) by _FoamCrestBias, so foam sits on crests and skips
    // equally-tall troughs. -lap is already the neighbourhood-mean minus centre (a pool-unit height),
    // so it is dimensionally comparable to _FoamMinWaveHeight.
    float crestHeight  = max(0.0, -lap);
    float heightSignal = lerp(abs(info.r), crestHeight, _FoamCrestBias);
    // TEMPORAL STICKINESS: an already-foaming cell keeps foaming through a brief dip below the
    // knees. Both gates are hard knees, and a raging sea's activity oscillates ACROSS them
    // frame-to-frame, so without this the whole crest field blinks (foam / no-foam / foam).
    // Physically: aerated water re-entrains far more readily than glassy water, so the breaking
    // threshold IS lower where foam already sits. 'foam' is last step's advected value, so the
    // relaxation follows the foam patch instead of the camera or the grid.
    float sticky = saturate(foam * FOAM_STICKY_SENSE) * FOAM_STICKY_KNEE_RELAX;
    float genThreshold = _FoamGenThreshold * (1.0 - sticky);
    float minWaveHeight = _FoamMinWaveHeight * (1.0 - sticky);
    float heightGate = smoothstep(minWaveHeight * 0.5, max(minWaveHeight, 1e-6),
                                  heightSignal);
    float gen = saturate(activity - genThreshold) * heightGate;

    // Shallow-water breaking boost (move #1): shallow AND supercritical water aerates far more
    // readily. Only ever multiplies gen UP, and only where a bed makes the column shallow, so
    // deep water and bedless bodies are untouched. See the uniform block above for the rationale.
    if (_UseBedDepth > 0.5 && _FoamBreakStrength > 0.0 && _FoamBreakRange > 0.0)
    {
        float2 uvCell   = ((float2)p + 0.5) * _Delta;
        float  depthCol = BedColumnDepth(uvCell);                            // pool-unit still-water column
        float  shallow  = 1.0 - smoothstep(0.0, _FoamBreakRange, depthCol);  // 1 shallow -> 0 deep
        float  froude   = speed / sqrt(FOAM_BREAK_GRAVITY * max(depthCol, FOAM_BREAK_MIN_DEPTH));
        float  breaking = smoothstep(FOAM_BREAK_FROUDE_LO, FOAM_BREAK_FROUDE_HI, froude);
        gen *= 1.0 + _FoamBreakStrength * FOAM_BREAK_MAX_BOOST * shallow * breaking;
    }

    // HEADROOM. Turbulence cannot aerate water that is already aerated, and this buffer is ONE
    // saturating scalar shared by every source - ripple turbulence, the wake stamp and the surf
    // injection below all sum into it. In the surf band the shore engine alone already drives the
    // column toward 1, so the ripple term only ever contributed the clipping: the band lost its
    // per-front structure and read as a flat white slab the moment foam was switched on.
    // Scaling the RATE by the free surface makes turbulence yield to whoever foamed the column
    // first ('foam' here is last step's value, already advected in, so the surf injection counts).
    //
    // The point is that this filters by WHERE THERE IS ROOM, not by how energetic the water is.
    // _FoamGenThreshold and _FoamMinWaveHeight can only do the latter, which is why raising them
    // to calm the shore also kills every splash and interaction: they cannot tell a bore from a
    // rock hitting the water. In open water foam is ~0, headroom is 1, and a splash foams exactly
    // as before.
    //
    // Only the RATE term is scaled. The deposit floor below is a max(), so it already self-limits
    // against existing foam - scaling it too would weaken real deposits for nothing.
    // _FoamHeadroom 0 = byte-identical.
    float headroom = lerp(1.0, saturate(1.0 - foam), _FoamHeadroom);
    foam += gen * headroom * (_FoamGenRate * _FoamDtSteps);
    // DEPOSIT floor: the rate term above only trickles foam in, so a wake that churns a cell for just a
    // few frames as it passes leaves almost nothing. Real turbulence DEPOSITS - one strong turbulent
    // moment lays a lasting patch of foam that the residual decay then dissolves (KWS floors the foam
    // mask with saturate(), it does not only accumulate). max() so the deposit never lowers foam that is
    // already thicker; gen carries all the gates + the shallow-break boost, so only real churn deposits.
    foam = max(foam, saturate(gen * _FoamDeposit));

    // Surf breaker-front foam (coastline): whitewash where fronts have broken, a thin line at the
    // cresting lip, and standing lace hugging the waterline - all injected as generation so the
    // sim advects and decays them into organic trails. Same pattern as the hero wave above.
    if (_ShoreFoamInject > 0.5)
    {
        float2 uvShore = ((float2)p + 0.5) * _Delta;
        float2 shoreWorldXZ = _ShoreSimUvToWorldOrigin.xy
                            + uvShore.x * _ShoreSimUvToWorldAxes.xy
                            + uvShore.y * _ShoreSimUvToWorldAxes.zw;
        float2 fieldUv = ShoreFieldUVFrom(shoreWorldXZ, _ShoreFieldCenterSim.xy,
                                          _ShoreFieldSizeSim.xy);
        float influence = ShoreFieldInfluence(fieldUv);
        if (influence > 0.001)
        {
            float shoreDepth = _ShoreDepthTexSim.SampleLevel(sampler_ShoreDepthTexSim,
                                                             saturate(fieldUv), 0);
            float4 shoreSdf = _ShoreSDFTexSim.SampleLevel(sampler_ShoreSDFTexSim,
                                                          saturate(fieldUv), 0);
            float2 toShore;
            ShoreDecodeToShore(shoreSdf.rg, toShore); // zero on degenerate - press on, as before
            SurfWaveSample surfSim = EvaluateSurfWaves(shoreWorldXZ, shoreDepth, shoreSdf.b,
                                                       toShore, shoreSdf.a, influence,
                                                       _ShoreFoamTime);
            // Waterline lace: peaks just offshore of the waterline and dies both ways - the
            // standing white edge every coast has, independent of the front rhythm. Gated by the
            // shore's exposure to the swell like everything else, so the lee side stays clean.
            float waterline = (1.0 - smoothstep(0.0, 1.0, shoreDepth))
                            * saturate(shoreDepth * 8.0) * influence * SurfExposure(toShore);
            // Crest injection: the artist pop curve when it is live (FOAM-1 - same LUT + inputs
            // as the surface, so sim foam is born exactly when the eye sees the crest pop),
            // the legacy fixed-weight breaker window otherwise.
            float crestInject = SURF_SIM_BREAKER_WEIGHT * surfSim.breaker;
            if (_ShoreCrestFoamLutActive > 0.5)
            {
                float crestLutU = saturate(surfSim.overCap / SURF_CREST_LUT_OVERCAP_MAX);
                crestInject = _ShoreCrestFoamLutSim.SampleLevel(sampler_ShoreCrestFoamLutSim,
                                                                float2(crestLutU, 0.5), 0).r
                            * surfSim.lipShape * _ShoreCrestFoamGain;
            }
            foam += (surfSim.whitewash + crestInject) * (_ShoreFoamGain * _FoamDtSteps);
            foam += waterline * (_ShoreWaterlineFoamGain * _FoamDtSteps);
            // DEPOSIT floor (same idea as the wake/turbulence deposit at the top of StepFoam):
            // the rate injection above only trickles foam in while the broken bore is physically
            // over THIS cell - a fraction of a second as the front sweeps through - so the
            // bi-exponential decay below erased the deposit before the next front arrived, i.e.
            // "foam deposit disappears very quick when another wave comes". Lay a LASTING patch
            // that the decay then dissolves, exactly like churned wake foam does. Reuses the
            // existing _FoamDeposit knob, so _FoamDeposit = 0 stays byte-identical (rate-only).
            foam = max(foam, saturate((surfSim.whitewash + crestInject) * _FoamDeposit));

            // FOAM-5: persistent SWASH DEPOSIT. As the backwash drains, its receding film edge
            // strands foam on the wet sand. Inject a deposit FLOOR where that edge passes each
            // beach cell, so the buffer holds it and the normal decay carries it away - deposits
            // LINGER across waves and fade over real time (the body's Foam Decay controls how
            // long), the persistent counterpart of the surface's per-cycle analytic swash line.
            // 0 = off. EvaluateSurfSwash returns 0 unless _SurfSwashAmplitude > 0 (bound alongside
            // the gain in ShoreFoamState.BindTo).
            if (_ShoreSwashDepositGain > 0.0)
            {
                float beachRise = -shoreDepth;                     // metres above still level (dry sand > 0)
                float2 swash = EvaluateSurfSwash(shoreWorldXZ, toShore, shoreSdf.a, influence,
                                                 _ShoreFoamTime);   // (film height, drying wet line)
                float phase = frac(_ShoreFoamTime / max(_SurfPeriod, SURF_MIN_PERIOD) - 0.5);
                // Only while the film is DRAINING (past the uprush apex), and only where the
                // receding edge (swash.x) is right at this cell's beach height - one burst per
                // cell as the water pulls back off it.
                float backwash = smoothstep(SURF_SWASH_UPRUSH,
                                            SURF_SWASH_UPRUSH + SHORE_SWASH_DEPOSIT_ONSET, phase);
                float edgePass = saturate(1.0 - abs(beachRise - swash.x) / SHORE_SWASH_DEPOSIT_BAND);
                // Cells below the waterline are NOT self-excluded by the band, whatever the comment
                // that used to sit here claimed. edgePass is a SYMMETRIC abs() around swash.x, and
                // swash.x is 0 through most of the cycle - so at beachRise = -0.10 m it still read
                // 0.5 and laid a persistent floor into the decay buffer 20 cm UNDER the water, every
                // wave: a standing foam ring in the shallows that never cleared. The exclusion has to
                // be WRITTEN DOWN, so here it is - 0 at the waterline, full one band up the dry sand,
                // which is what "the backwash strands foam on the WET SAND" actually means.
                float drySide = saturate(beachRise / SHORE_SWASH_DEPOSIT_BAND);
                // The swash's own steepness cap. EvaluateSurfSwash applies it to that function's
                // LOCAL copy of influence, so it never reached the strength below - which was built
                // from the raw influence passed IN. That is why deposits appeared everywhere with no
                // regard for slope, cliffs included, where the very swash that is supposed to strand
                // them is switched off and EvaluateSurfSwash is returning 0.
                float slopeGate = SurfSwashSlopeGate(shoreSdf.a);
                float deposit = backwash * edgePass * drySide * slopeGate
                              * influence * SurfExposure(toShore);
                foam = max(foam, saturate(deposit * _ShoreSwashDepositGain));
            }
        }
    }

    // Bi-exponential decay: thick foam dies at the fresh rate, thin foam at the
    // (slower) residual rate, so bursts collapse fast but leave lingering lace.
    // pow() rebases the per-reference-step survival onto the real elapsed time
    // (frame-rate independence) and _FoamDecayRate rescales fade speed linearly -
    // a far gentler tuning handle than the survival factors, which compound ~60x
    // per second and swing the look violently within a few hundredths.
    // Shared blend (FoamDecayBlend, WaterFoamCommon.hlsl); NOTE this path blends
    // SURVIVAL factors (fresh/thick = FASTER decay) while OceanFft blends decay
    // RATES (dense = SLOWER) - opposite semantics, both deliberate, documented there.
    float survival = saturate(
        FoamDecayBlend(foam, FOAM_FRESH_THRESHOLD, _FoamDecayResidual, _FoamDecayFresh));
    foam *= pow(survival, _FoamDtSteps * _FoamDecayRate);

    // --- Wet mark (G): how high the water has BEEN here, not how high it is now -------------------
    // Foam answers "is there foam on this column". This answers "what is the highest waterline this
    // column has seen lately", which is the only thing that can keep ground wet AFTER the wave that
    // wetted it has moved on. Without it the wet line chases the trough and the ground dries the
    // same frame the crest leaves.
    //
    // LINEAR drop, not the bi-exponential survival the foam uses: "the waterline dries N centimetres
    // per second" is a quantity a human can author, where a per-step survival factor is not. It is
    // also the physically right shape - a drying film recedes at a roughly constant rate, it does not
    // halve. Clamped at 0 because at and below the still level the column is submerged and there is
    // nothing left to dry.
    // No clamp needed: an exponential of a non-negative mark stays non-negative, and the max() below
    // re-floors it at the live surface anyway.
    float driedMark = FoamSrc.Load(int3(p, 0)).g * _WetDryDecay;
    float wetMark = max(info.r, driedMark);

    FoamDst[p] = float2(saturate(foam) * _FoamWriteMask, wetMark);
}

// NOTE on structure: WGSL's uniformity analysis (WebGPU) is more conservative than the
// HLSL spec and rejects the classic tree reduction (barriers inside a loop that also
// contains thread-index branches). Both kernels therefore keep every barrier in
// straight-line, provably uniform control flow: all threads write groupshared, ONE
// barrier, then thread 0 serially sums the 64 slots (negligible at this size). Loop
// trip counts are uniform and out-of-range reads use select(), never a branch.

// Pass 1: each 8x8 group sums its 64 heights and writes one partial sum.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ReduceMean(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex, uint3 gid : SV_GroupID)
{
    gsSum[gi] = Read(int2(id.xy)).r;
    GroupMemoryBarrierWithGroupSync();

    if (gi == 0)
    {
        float sum = 0.0;
        [unroll]
        for (uint i = 0; i < REDUCE_GROUP_THREADS; i++) sum += gsSum[i];
        uint groupsPerSide = (uint)_Size / THREAD_GROUP_SIZE;
        PartialSums[gid.y * groupsPerSide + gid.x] = sum;
    }
}

// Pass 2 (single group): strided sum over all partials, then divide by the texel
// count. Handles any grid size that is a multiple of the thread-group size.
[numthreads(REDUCE_GROUP_THREADS, 1, 1)]
void ReduceMeanFinal(uint gi : SV_GroupIndex)
{
    uint groupsPerSide = (uint)_Size / THREAD_GROUP_SIZE;
    uint count = groupsPerSide * groupsPerSide;
    uint iterations = (count + REDUCE_GROUP_THREADS - 1) / REDUCE_GROUP_THREADS; // uniform trip count

    float sum = 0.0;
    for (uint k = 0; k < iterations; k++)
    {
        uint i = gi + k * REDUCE_GROUP_THREADS;
        sum += (i < count) ? PartialSums[i] : 0.0; // select, not a branch
    }
    gsSum[gi] = sum;
    GroupMemoryBarrierWithGroupSync();

    if (gi == 0)
    {
        float total = 0.0;
        [unroll]
        for (uint i = 0; i < REDUCE_GROUP_THREADS; i++) total += gsSum[i];
        MeanResult[0] = total / (_Size * _Size);
    }
}

// Maximum normalized visible activity. Reducing a max rather than an average means one small/localized
// wake cannot disappear merely because it occupies few texels in a large ocean window.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ReduceActivity(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex, uint3 gid : SV_GroupID)
{
    int2 p = int2(id.xy);
    float4 state = Read(p);
    float2 flow = ReadFlow(p);
    float2 foamWetMark = FoamSrc.Load(int3(p, 0));
    float activity = abs(state.r) * _ActivityInverseThresholds.x;
    activity = max(activity, abs(state.g) * _ActivityInverseThresholds.y);
    activity = max(activity, length(flow) * _ActivityInverseThresholds.z);
    activity = max(activity, abs(foamWetMark.r) * _ActivityInverseThresholds.w);
    activity = max(activity, abs(foamWetMark.g) * _ActivityWetMarkInverseThreshold);
    gsSum[gi] = activity;
    GroupMemoryBarrierWithGroupSync();

    if (gi == 0)
    {
        float maximum = 0.0;
        [unroll]
        for (uint i = 0; i < REDUCE_GROUP_THREADS; i++) maximum = max(maximum, gsSum[i]);
        uint groupsPerSide = (uint)_Size / THREAD_GROUP_SIZE;
        ActivityPartialMax[gid.y * groupsPerSide + gid.x] = maximum;
    }
}

[numthreads(REDUCE_GROUP_THREADS, 1, 1)]
void ReduceActivityFinal(uint gi : SV_GroupIndex)
{
    uint groupsPerSide = (uint)_Size / THREAD_GROUP_SIZE;
    uint count = groupsPerSide * groupsPerSide;
    uint iterations = (count + REDUCE_GROUP_THREADS - 1) / REDUCE_GROUP_THREADS;
    float maximum = 0.0;
    for (uint k = 0; k < iterations; k++)
    {
        uint i = gi + k * REDUCE_GROUP_THREADS;
        maximum = max(maximum, (i < count) ? ActivityPartialMax[i] : 0.0);
    }
    gsSum[gi] = maximum;
    GroupMemoryBarrierWithGroupSync();

    if (gi == 0)
    {
        float totalMaximum = 0.0;
        [unroll]
        for (uint i = 0; i < REDUCE_GROUP_THREADS; i++) totalMaximum = max(totalMaximum, gsSum[i]);
        ActivityResult[0] = totalMaximum;
    }
}

// Subtract the (exact) mean height so the closed pool conserves volume - stops the
// whole surface drifting up as positive drops (touch drags, wake drops) are added.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Conserve(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    float4 info = Read(p);
    float mean = MeanResult[0];
    // Safety clamp only: the mean is exact now, but a diverged transient (see Sanitize)
    // should still never be allowed to shift the whole plane in one step.
    mean = clamp(mean, -_MeanCorrectionMax, _MeanCorrectionMax);
    info.r -= mean;
    Dst[p] = info;
}

// True when a source texel index lies inside the grid.
bool InGrid(int2 p) { return all(p >= 0) && all(p < (int)_Size); }

// Shift the height/velocity/normal state by _ScrollOffset texels. Cells whose
// source falls outside the grid (newly exposed at the trailing edge) reset to rest.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void Scroll(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    int2 src = p - _ScrollOffset;
    Dst[p] = InGrid(src) ? Src.Load(int3(src, 0)) : REST_STATE;
    FlowDst[p] = InGrid(src) ? FlowSrc.Load(int3(src, 0)) : (float2)0.0;
}

// Same shift for the foam buffer; newly exposed cells reset to zero foam.
[numthreads(THREAD_GROUP_SIZE, THREAD_GROUP_SIZE, 1)]
void ScrollFoam(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    int2 src = p - _ScrollOffset;
    FoamDst[p] = InGrid(src) ? FoamSrc.Load(int3(src, 0)) : (float2)0.0;
}
