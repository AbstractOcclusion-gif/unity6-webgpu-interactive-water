  m_Script: {fileID: 11500000, guid: 3f9c1d5a7b2e4c8d9a0f6b3e5c7d1a24, type: 3}
  m_Name:
  m_EditorClassIdentifier: AbstractOcclusion.WebGpuWater::AbstractOcclusion.WebGpuWater.WaterDemoOverlay
  title: Deep Lake
  description: 'Depth-aware downwelling extinction , so colour is driven by how much
    water the ray crossed rather than by a flat tint. Caustics and god rays can decrease
    by depth . Pool is standard game oject with WATER RECIEVER shader for caustics
    . You can use 3D screen caustics to project onto any material . Pillar has reflect
    wave ticked to act on water without moving because solver only work when object
    move . '
  corner: 2
  panelWidth: 460
  screenMargin: 14
  paddingHorizontal: 12
  paddingVertical: 10
  titleFontSize: 28
  bodyFontSize: 22
  textColor: {r: 1, g: 1, b: 1, a: 1}
  backgroundTint: {r: 1, g: 1, b: 1, a: 1}
  uiScale: 1
  showFrameRate: 1
  frameSmoothing: 0.05
