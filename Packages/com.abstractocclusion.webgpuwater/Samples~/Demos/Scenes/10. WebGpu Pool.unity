  m_Name:
  m_EditorClassIdentifier: AbstractOcclusion.WebGpuWater::AbstractOcclusion.WebGpuWater.WaterDemoOverlay
  title: WebGpu Pool
  description: 'The pool tuned for the WebGPU browser target: compute-backed sim,
    god rays and a floating prop, sized to run on entry-level mobile GPUs. Force
    low quality ON in water quality settings . If refraction or god ray  dont show
    in scene or build ensure that opaque texture and draw on transparent is ticked
    into Unity URP asset '
  corner: 2
  panelWidth: 460
  screenMargin: 14
  paddingHorizontal: 12
  paddingVertical: 10
