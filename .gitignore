# The repo holds ONLY the package and the project settings. Everything else at the
# project root is local (notes, prompts, scratch, demos, docs) and stays out.
/*
!/Packages/
!/ProjectSettings/
!/.gitignore
!/.gitattributes
# The GitHub front page: the root readme/licence and the demo media it shows.
# Only media at the top of docs/ - the internal notes and subfolders stay local.
!/README.md
!/LICENSE.md
!/docs/
/docs/*
!/docs/*.png
!/docs/*.gif
!/docs/*.mp4
/docs/*(1)*

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Pp]rofilerCaptures/
[Rr]ecordings/

# Local project content: the package under Packages/com.abstractocclusion.webgpuwater is the
# product; Assets/ only holds local test scenes, imported package samples and scratch content,
# so the whole folder (including Assets/Samples) stays out of the repo.
/[Aa]ssets/
/[Aa]ssets.meta

# Visual Studio / Rider / IDE
.vs/
.idea/
.vsconfig
*.csproj
*.sln
*.slnx
*.user
*.userprefs
*.suo
*.tmp

# OS
.DS_Store
Thumbs.db

# Unity crash / build artifacts
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties

# Asset Store publishing tools (local dev tool, embedded package - not for the repo).
# (The Assets/AssetStoreTools entries are gone: the whole /Assets/ folder is ignored above.)
/[Pp]ackages/com.unity.asset-store-tools/
